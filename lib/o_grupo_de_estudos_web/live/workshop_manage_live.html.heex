<div id="workshop-manage-shell" class="min-h-screen bg-ink-100 font-serif flex flex-col">
  <.flash kind={:info} id="lv-flash-info" flash={@flash} />
  <.flash kind={:error} id="lv-flash-error" flash={@flash} />

  <.top_nav
    current_user={@current_user}
    is_admin={@is_admin}
    nav_mode={:detail}
    title="Gerenciar workshop"
    notification_count={@notification_count}
    notification_dropdown_enabled={true}
    notification_dropdown_open={@notification_dropdown_open}
    notification_preview_groups={@notification_preview_groups}
    notification_targets={@notification_targets}
    pending_suggestions_count={@pending_suggestions_count}
    pending_study_count={@pending_study_count}
    online_users={@online_users}
    online_count={@online_count}
  />

  <main class="mx-auto w-full max-w-[900px] flex-1 px-4 py-6 sm:px-6">
    <.link
      navigate={~p"/workshops/#{@workshop.slug}"}
      class="mb-4 inline-flex items-center gap-1.5 text-[13px] font-semibold text-ink-500 no-underline hover:text-ink-800"
    >
      <.icon name="hero-arrow-left" class="size-4" /> Página do workshop
    </.link>

    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <h1 class="m-0 font-serif text-[22px] font-bold tracking-tight text-ink-900">
          {@workshop.title}
        </h1>
        <p class="m-0 mt-1 text-[13px] text-ink-500">{schedule_label(@workshop)}</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          phx-click="copy_link"
          class="cursor-pointer rounded-full border border-ink-300 bg-ink-50 px-4 py-2 font-serif text-[13px] font-semibold text-ink-700"
        >
          <.icon name="hero-link" class="size-4 -mt-0.5" /> Copiar link
        </button>
        <.link
          navigate={~p"/study/workshops/#{@workshop.slug}/edit"}
          class="rounded-full border border-ink-300 bg-ink-50 px-4 py-2 font-serif text-[13px] font-semibold text-ink-700 no-underline"
        >
          Editar
        </.link>
        <button
          :if={@workshop.status == :draft}
          type="button"
          phx-click="publish"
          phx-disable-with="Publicando..."
          class="cursor-pointer rounded-full border-0 bg-accent-orange px-4 py-2 font-serif text-[13px] font-semibold text-white"
        >
          Publicar
        </button>
      </div>
    </div>

    <div :if={@workshop.status == :draft} class="mt-4 rounded-xl bg-gold-500/15 px-4 py-3">
      <p class="m-0 text-[13px] font-bold text-ink-700">
        Ainda é rascunho: ninguém além de você enxerga, e o link não aceita inscrição.
      </p>
    </div>

    <div :if={@workshop.status == :cancelled} class="mt-4 rounded-xl bg-accent-red/10 px-4 py-3">
      <p class="m-0 text-[13px] font-bold text-accent-red">
        Workshop cancelado. O registro dos inscritos continua aqui.
      </p>
    </div>

    <%!-- Privacy notice: the organizer needs to know they are the only one who sees
         this.
    --%>
    <div
      :if={@cobra?}
      class="mt-5 flex items-start gap-2.5 rounded-xl border border-gold-500/35 bg-gold-500/12 px-4 py-3"
    >
      <.icon name="hero-lock-closed" class="size-4 shrink-0 text-ink-600" />
      <p class="m-0 text-[12.5px] leading-snug text-ink-700">
        <b class="text-ink-900">Só você vê esta tela.</b>
        O controle de pagamento não aparece para os inscritos nem na página pública.
      </p>
    </div>

    <%!-- Numbers. A free workshop has nothing to charge: "a receber" and "recebido"
         would only show up to say zero.
    --%>
    <div class={[
      "mt-5 grid gap-2.5",
      @cobra? && "grid-cols-2 sm:grid-cols-4",
      !@cobra? && "grid-cols-1"
    ]}>
      <div class="rounded-2xl border border-ink-200 bg-ink-50 p-3.5 text-center">
        <p class="m-0 font-serif text-[22px] font-bold leading-none tracking-tight text-ink-900">
          {@summary.total}
        </p>
        <p class="m-0 mt-1.5 text-[10px] font-bold uppercase tracking-[1.3px] text-ink-500">
          inscritos
        </p>
      </div>
      <div :if={@cobra?} class="rounded-2xl border border-ink-200 bg-ink-50 p-3.5 text-center">
        <p class="m-0 font-serif text-[22px] font-bold leading-none tracking-tight text-accent-green">
          {@summary.paid}
        </p>
        <p class="m-0 mt-1.5 text-[10px] font-bold uppercase tracking-[1.3px] text-ink-500">
          pagaram
        </p>
      </div>
      <div :if={@cobra?} class="rounded-2xl border border-ink-200 bg-ink-50 p-3.5 text-center">
        <p class="m-0 font-serif text-[22px] font-bold leading-none tracking-tight text-accent-orange">
          {@summary.total - @summary.paid - @summary.waived}
        </p>
        <p class="m-0 mt-1.5 text-[10px] font-bold uppercase tracking-[1.3px] text-ink-500">
          a receber
        </p>
      </div>
      <div :if={@cobra?} class="rounded-2xl border border-ink-200 bg-ink-50 p-3.5 text-center">
        <p class="m-0 font-serif text-[22px] font-bold leading-none tracking-tight text-ink-900">
          {revenue_label(@summary, @workshop)}
        </p>
        <p class="m-0 mt-1.5 text-[10px] font-bold uppercase tracking-[1.3px] text-ink-500">
          recebido
        </p>
      </div>
    </div>

    <%!-- Lista de inscritos --%>
    <section class="mt-6">
      <h2 class="m-0 mb-2.5 text-[11px] font-bold uppercase tracking-[2px] text-ink-500">
        Inscritos
      </h2>

      <div
        :if={@enrollments != []}
        class="overflow-hidden rounded-2xl border border-ink-200 bg-ink-50"
      >
        <%!-- On mobile the row becomes two bands: who the person is, and what can be
             done. All in one line, the name was squeezed into three lines and the
             buttons fell one way for who paid and another for who did not.
        --%>
        <div
          :for={enrollment <- @enrollments}
          id={"enrollment-#{enrollment.id}"}
          class="flex flex-wrap items-center gap-x-3 gap-y-2.5 border-b border-ink-200 px-4 py-3 last:border-b-0"
        >
          <div class="flex min-w-0 flex-1 basis-full items-center gap-3 sm:basis-auto">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink-900 text-[11px] font-bold text-ink-50">
              {String.first(enrollment.user.name || enrollment.user.username)}
            </span>

            <div class="min-w-0 flex-1">
              <p class="m-0 truncate text-[13.5px] font-bold text-ink-900">
                {enrollment.user.name}
              </p>
              <p class="m-0 truncate text-[11.5px] text-ink-500">
                @{enrollment.user.username} · inscreveu-se em {OGrupoDeEstudos.Brazil.format_datetime(
                  enrollment.inserted_at
                )}
              </p>
            </div>
          </div>

          <span
            :if={@cobra?}
            class={[
              "inline-flex shrink-0 items-center rounded-full px-3 py-1 text-[11.5px] font-bold",
              enrollment.payment_status == :paid && "bg-accent-green/15 text-accent-green",
              enrollment.payment_status == :pending && "bg-accent-orange/15 text-accent-orange",
              enrollment.payment_status == :waived && "bg-ink-200 text-ink-600"
            ]}
          >
            {payment_status_label(enrollment.payment_status)}
          </span>

          <div :if={@cobra?} class="flex shrink-0 gap-1.5">
            <button
              :if={enrollment.payment_status != :paid}
              type="button"
              phx-click="set_payment"
              phx-value-id={enrollment.id}
              phx-value-status="paid"
              phx-disable-with="..."
              class="cursor-pointer rounded-full border-0 bg-ink-900 px-3 py-1.5 font-serif text-[12px] font-semibold text-ink-50"
            >
              Marcar pago
            </button>
            <button
              :if={enrollment.payment_status == :paid}
              type="button"
              phx-click="set_payment"
              phx-value-id={enrollment.id}
              phx-value-status="pending"
              class="cursor-pointer rounded-full border border-ink-300 bg-ink-50 px-3 py-1.5 font-serif text-[12px] font-semibold text-ink-600"
            >
              Desfazer
            </button>
            <button
              :if={enrollment.payment_status == :pending}
              type="button"
              phx-click="set_payment"
              phx-value-id={enrollment.id}
              phx-value-status="waived"
              class="cursor-pointer rounded-full border border-ink-300 bg-ink-50 px-3 py-1.5 font-serif text-[12px] font-semibold text-ink-600"
            >
              Isentar
            </button>
          </div>
        </div>
      </div>

      <.workshop_empty
        :if={@enrollments == []}
        title="Ninguém inscrito ainda"
        description="Compartilhe o link do workshop para as inscrições começarem."
      >
        <:action>
          <button
            type="button"
            phx-click="copy_link"
            class="cursor-pointer rounded-full border-0 bg-accent-orange px-4 py-2 font-serif text-[13px] font-semibold text-white"
          >
            Copiar link do workshop
          </button>
        </:action>
      </.workshop_empty>
    </section>

    <%!-- Request queue: it only exists on a private workshop. --%>
    <section :if={@workshop.visibility == :private} class="mt-8">
      <h2 class="m-0 mb-1 text-[11px] font-bold uppercase tracking-[2px] text-ink-500">
        Pedidos para entrar
        <span :if={@requests != []} class="text-gold-600">· {length(@requests)} esperando</span>
      </h2>
      <p class="m-0 mb-3 text-[12.5px] text-ink-500">
        Este workshop aparece na agenda como qualquer outro, mas a entrada passa por você.
        Aceitar já matricula a pessoa.
      </p>

      <div
        :if={@requests != []}
        class="overflow-hidden rounded-2xl border border-ink-200 bg-ink-50"
      >
        <div
          :for={request <- @requests}
          id={"pedido-#{request.id}"}
          class="flex flex-wrap items-center gap-x-3 gap-y-2.5 border-b border-ink-200 px-4 py-3 last:border-b-0"
        >
          <div class="flex min-w-0 flex-1 basis-full items-center gap-3 sm:basis-auto">
            <.user_avatar user={request} size={:md} />
            <div class="min-w-0 flex-1">
              <p class="m-0 truncate text-[13.5px] font-bold text-ink-900">
                {request.name || request.username}
              </p>
              <p class="m-0 truncate text-[11.5px] text-ink-500">
                @{request.username}{request_city(request)} · pediu em {OGrupoDeEstudos.Brazil.format_datetime(
                  request.requested_at
                )}
              </p>
            </div>
          </div>

          <div class="flex shrink-0 gap-1.5">
            <button
              type="button"
              phx-click="approve_join"
              phx-value-id={request.id}
              phx-disable-with="..."
              class="cursor-pointer rounded-full border-0 bg-accent-green px-4 py-1.5 font-serif text-[12px] font-semibold text-white"
            >
              Aceitar
            </button>
            <button
              type="button"
              phx-click="reject_join"
              phx-value-id={request.id}
              data-confirm={"Recusar o pedido de #{request.name || request.username}?"}
              class="cursor-pointer rounded-full border border-ink-300 bg-ink-50 px-4 py-1.5 font-serif text-[12px] font-semibold text-ink-600"
            >
              Recusar
            </button>
          </div>
        </div>
      </div>

      <p :if={@requests == []} class="m-0 text-[13px] text-ink-500">
        Nenhum pedido esperando. Quando alguém pedir para entrar, aparece aqui.
      </p>
    </section>

    <%!-- Waitlist: pent-up demand as a number. A long waitlist is the signal that
         another class fits, and that is what was lost when the page only said "sold
         out".
    --%>
    <section :if={@waitlist != []} class="mt-8">
      <h2 class="m-0 mb-1 text-[11px] font-bold uppercase tracking-[2px] text-ink-500">
        Lista de espera <span class="text-accent-orange">· {length(@waitlist)} esperando</span>
      </h2>
      <p class="m-0 mb-3 text-[12.5px] text-ink-500">
        Gente que quis entrar e não coube. Se alguém cancelar, a primeira da fila entra
        sozinha. Fila cheia costuma valer uma turma nova.
      </p>

      <div class="overflow-hidden rounded-2xl border border-ink-200 bg-ink-50">
        <div
          :for={{pessoa, indice} <- Enum.with_index(@waitlist, 1)}
          class="flex items-center gap-3 border-b border-ink-200 px-4 py-2.5 last:border-b-0"
        >
          <span class="w-5 shrink-0 text-[12px] font-bold tabular-nums text-ink-400">
            {indice}º
          </span>
          <.user_avatar user={pessoa} size={:sm} />
          <div class="min-w-0 flex-1">
            <p class="m-0 truncate text-[13px] font-bold text-ink-900">
              {pessoa.name || pessoa.username}
            </p>
            <p class="m-0 truncate text-[11.5px] text-ink-500">@{pessoa.username}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-8">
      <h2 class="m-0 mb-1 text-[11px] font-bold uppercase tracking-[2px] text-ink-500">
        Quem organiza
      </h2>
      <p class="m-0 mb-3 text-[12.5px] text-ink-500">
        Co-organizador edita o workshop, vê os inscritos e o controle de pagamento.
        Só você, que criou, adiciona ou remove gente daqui.
      </p>

      <div class="overflow-hidden rounded-2xl border border-ink-200 bg-ink-50">
        <div class="flex flex-wrap items-center gap-3 border-b border-ink-200 px-4 py-3">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink-900 text-[11px] font-bold text-ink-50">
            {String.first(@workshop.organizer.name || @workshop.organizer.username)}
          </span>
          <div class="min-w-0 flex-1">
            <p class="m-0 truncate text-[13.5px] font-bold text-ink-900">
              {@workshop.organizer.name}
            </p>
            <p class="m-0 text-[11.5px] text-ink-500">@{@workshop.organizer.username}</p>
          </div>
          <span class="shrink-0 rounded-full bg-gold-500/20 px-3 py-1 text-[11.5px] font-bold text-ink-700">
            Criou o workshop
          </span>
        </div>

        <div
          :for={admin <- @co_admins}
          id={"co-admin-#{admin.id}"}
          class="flex flex-wrap items-center gap-3 border-b border-ink-200 px-4 py-3 last:border-b-0"
        >
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink-900 text-[11px] font-bold text-ink-50">
            {String.first(admin.name || admin.username)}
          </span>
          <div class="min-w-0 flex-1">
            <p class="m-0 truncate text-[13.5px] font-bold text-ink-900">{admin.name}</p>
            <p class="m-0 text-[11.5px] text-ink-500">@{admin.username}</p>
          </div>
          <button
            :if={@owner?}
            type="button"
            phx-click="remove_admin"
            phx-value-id={admin.user_id}
            data-confirm={"Tirar #{admin.name || admin.username} da organizacao deste workshop?"}
            class="shrink-0 cursor-pointer rounded-full border border-ink-300 bg-ink-50 px-3 py-1.5 font-serif text-[12px] font-semibold text-ink-600"
          >
            Remover
          </button>
        </div>
      </div>

      <form
        :if={@owner?}
        id="add-admin-form"
        phx-submit="add_admin"
        class="mt-3 flex flex-wrap items-center gap-2"
      >
        <input
          type="text"
          name="username"
          placeholder="Nome de usuário de quem vai organizar com você"
          autocomplete="off"
          required
          class="min-w-0 flex-1 rounded-full border border-ink-300 bg-ink-50 px-4 py-2 font-serif text-[13px] text-ink-800 placeholder:text-ink-400"
        />
        <button
          type="submit"
          phx-disable-with="Adicionando..."
          class="cursor-pointer rounded-full border-0 bg-ink-900 px-4 py-2 font-serif text-[13px] font-semibold text-ink-50"
        >
          Adicionar
        </button>
      </form>

      <p :if={@admin_form_error} class="m-0 mt-2 text-[12.5px] font-semibold text-accent-red">
        {@admin_form_error}
      </p>
    </section>

    <%!-- Cancel: a destructive action, kept away from the rest. --%>
    <section
      :if={@owner? && @workshop.status != :cancelled}
      class="mt-8 border-t border-ink-200 pt-5"
    >
      <button
        type="button"
        phx-click="cancel_workshop"
        data-confirm="Cancelar este workshop? Os inscritos continuam registrados e o histórico é preservado."
        class="cursor-pointer border-0 bg-transparent p-0 text-[12.5px] font-semibold text-accent-red underline"
      >
        Cancelar este workshop
      </button>
    </section>
  </main>
</div>
