<div id="workshop-form-shell" class="min-h-screen bg-ink-100 font-serif flex flex-col">
  <.flash kind={:info} id="lv-flash-info" flash={@flash} />
  <.flash kind={:error} id="lv-flash-error" flash={@flash} />

  <.top_nav
    current_user={@current_user}
    is_admin={@is_admin}
    nav_mode={:detail}
    title={if @workshop, do: "Editar workshop", else: "Novo workshop"}
  />

  <main class="mx-auto w-full max-w-[720px] flex-1 px-4 py-6 sm:px-6">
    <.link
      navigate={~p"/study/workshops"}
      class="mb-4 inline-flex items-center gap-1.5 text-[13px] font-semibold text-ink-500 no-underline hover:text-ink-800"
    >
      <.icon name="hero-arrow-left" class="size-4" /> Workshops
    </.link>

    <h1 class="m-0 font-serif text-[24px] font-bold tracking-tight text-ink-900">
      {if @workshop, do: "Editar workshop", else: "Novo workshop"}
    </h1>
    <p class="m-0 mb-5 mt-1 text-[13.5px] text-ink-500">
      Um evento pontual, com data e link próprio. Quem se inscreve não vira seu aluno.
    </p>

    <div
      :if={@program}
      class="mb-4 flex items-start gap-2.5 rounded-xl border border-accent-purple/30 bg-accent-purple/10 px-4 py-3"
    >
      <.icon name="hero-calendar-days" class="size-4 shrink-0 text-accent-purple" />
      <p class="m-0 text-[12.5px] leading-snug text-ink-700">
        Este workshop já vai entrar na programação <b class="text-ink-900">{@program.title}</b>
        assim que você salvar.
      </p>
    </div>

    <form id="workshop-form" phx-change="validate" phx-submit="save">
      <div class="rounded-2xl border border-ink-200 bg-ink-50 p-5 shadow-sm">
        <div class="mb-4">
          <label
            for="workshop-title"
            class="mb-1.5 block text-[10px] font-bold uppercase tracking-[1.3px] text-ink-500"
          >
            Título
          </label>
          <input
            id="workshop-title"
            type="text"
            name="workshop[title]"
            phx-debounce="300"
            value={@form["title"]}
            maxlength="140"
            required
            placeholder="Ex.: Workshop de sacadas"
            class="w-full rounded-lg border border-ink-200 bg-ink-100/40 px-3 py-2.5 font-serif text-sm text-ink-800 placeholder:text-ink-400"
          />
        </div>

        <div class="mb-4 grid gap-3 sm:grid-cols-2">
          <div>
            <label
              for="workshop-starts-at"
              class="mb-1.5 block text-[10px] font-bold uppercase tracking-[1.3px] text-ink-500"
            >
              Quando começa
            </label>
            <input
              id="workshop-starts-at"
              type="datetime-local"
              name="workshop[starts_at]"
              value={@form["starts_at"]}
              required
              class="w-full rounded-lg border border-ink-200 bg-ink-100/40 px-3 py-2.5 font-serif text-sm text-ink-800"
            />
          </div>
          <div>
            <label
              for="workshop-duration"
              class="mb-1.5 block text-[10px] font-bold uppercase tracking-[1.3px] text-ink-500"
            >
              Quanto dura
            </label>
            <select
              id="workshop-duration"
              name="workshop[duration]"
              class="w-full rounded-lg border border-ink-200 bg-ink-100/40 px-3 py-2.5 font-serif text-sm text-ink-800"
            >
              <option
                :for={{value, label} <- duration_options()}
                value={value}
                selected={@form["duration"] == value}
              >
                {label}
              </option>
              <option value="custom" selected={@form["duration"] == "custom"}>
                Outro / mais de um dia
              </option>
            </select>
          </div>
        </div>

        <%!-- The end date only comes back for what the list cannot say: a festival
             across days, or an odd length. Asking it of everyone meant typing the
             same date twice to describe a two-hour class. --%>
        <div :if={@form["duration"] == "custom"} class="mb-4">
          <label
            for="workshop-ends-at"
            class="mb-1.5 block text-[10px] font-bold uppercase tracking-[1.3px] text-ink-500"
          >
            Quando termina
            <span class="font-normal normal-case tracking-normal">(vazio = sem hora de fim)</span>
          </label>
          <input
            id="workshop-ends-at"
            type="datetime-local"
            name="workshop[ends_at]"
            value={@form["ends_at"]}
            class="w-full rounded-lg border border-ink-200 bg-ink-100/40 px-3 py-2.5 font-serif text-sm text-ink-800 sm:max-w-[50%]"
          />
        </div>

        <div class="mb-4 grid gap-3 sm:grid-cols-2">
          <div>
            <label
              for="workshop-location"
              class="mb-1.5 block text-[10px] font-bold uppercase tracking-[1.3px] text-ink-500"
            >
              Onde
            </label>
            <input
              id="workshop-location"
              type="text"
              name="workshop[location]"
              phx-debounce="300"
              value={@form["location"]}
              placeholder="Curitiba, Juvevê"
              class="w-full rounded-lg border border-ink-200 bg-ink-100/40 px-3 py-2.5 font-serif text-sm text-ink-800 placeholder:text-ink-400"
            />
          </div>
          <div>
            <label
              for="workshop-capacity"
              class="mb-1.5 block text-[10px] font-bold uppercase tracking-[1.3px] text-ink-500"
            >
              Vagas
              <span class="font-normal normal-case tracking-normal">(vazio = sem limite)</span>
            </label>
            <input
              id="workshop-capacity"
              type="number"
              min="1"
              name="workshop[capacity]"
              phx-debounce="300"
              value={@form["capacity"]}
              placeholder="50"
              class="w-full rounded-lg border border-ink-200 bg-ink-100/40 px-3 py-2.5 font-serif text-sm text-ink-800 placeholder:text-ink-400"
            />
          </div>
        </div>

        <div class="mb-4 grid gap-3 sm:grid-cols-2">
          <div>
            <label
              for="workshop-price"
              class="mb-1.5 block text-[10px] font-bold uppercase tracking-[1.3px] text-ink-500"
            >
              Preço
              <span class="font-normal normal-case tracking-normal">(vazio = gratuito)</span>
            </label>
            <input
              id="workshop-price"
              type="text"
              inputmode="decimal"
              name="workshop[price]"
              phx-debounce="300"
              value={@form["price"]}
              placeholder="80,00"
              class="w-full rounded-lg border border-ink-200 bg-ink-100/40 px-3 py-2.5 font-serif text-sm text-ink-800 placeholder:text-ink-400"
            />
          </div>
          <div>
            <label
              for="workshop-payment-info"
              class="mb-1.5 block text-[10px] font-bold uppercase tracking-[1.3px] text-ink-500"
            >
              Chave Pix ou instrução
            </label>
            <input
              id="workshop-payment-info"
              type="text"
              name="workshop[payment_info]"
              phx-debounce="300"
              value={@form["payment_info"]}
              maxlength="200"
              placeholder="Pix: seu@email.com"
              class="w-full rounded-lg border border-ink-200 bg-ink-100/40 px-3 py-2.5 font-serif text-sm text-ink-800 placeholder:text-ink-400"
            />
          </div>
        </div>

        <div class="mb-2">
          <label
            for="workshop-description"
            class="mb-1.5 block text-[10px] font-bold uppercase tracking-[1.3px] text-ink-500"
          >
            Descrição
          </label>
          <textarea
            id="workshop-description"
            name="workshop[description]"
            rows="7"
            phx-debounce="300"
            required
            placeholder="O que vai ser trabalhado, para quem é, o que levar..."
            class="w-full rounded-lg border border-ink-200 bg-ink-100/40 px-3 py-2.5 font-serif text-sm leading-relaxed text-ink-800 placeholder:text-ink-400"
          >{@form["description"]}</textarea>
        </div>

        <div class="mt-4">
          <%!-- Who teaches is an explicit choice, because producing someone else's
               class is the common case. A visiting teacher does not always have an
               account, so a written name counts too.
          --%>
          <div class="mb-5">
            <p class="mb-1 text-[12.5px] font-bold text-ink-700">Quem dá a aula</p>
            <p class="m-0 mb-2 text-[11.5px] leading-snug text-ink-500">
              Um ou dois. Quem organiza não entra sozinho: se você também dá a aula,
              coloque seu usuário aqui.
            </p>

            <div :for={indice <- [0, 1]} class="mb-2">
              <div class="flex flex-wrap items-center gap-2">
                <input
                  type="text"
                  name={"workshop[teacher_username][#{indice}]"}
                  phx-debounce="300"
                  value={teacher_field(@form["teacher_username"], indice)}
                  placeholder={
                    if indice == 0, do: "usuário no site", else: "usuário no site (opcional)"
                  }
                  class="min-w-0 flex-1 rounded-lg border border-ink-200 bg-ink-100/40 px-3 py-2.5 font-serif text-sm text-ink-800 placeholder:text-ink-400"
                />
                <span class="text-[11.5px] text-ink-400">ou</span>
                <input
                  type="text"
                  name={"workshop[teacher_name][#{indice}]"}
                  phx-debounce="300"
                  value={teacher_field(@form["teacher_name"], indice)}
                  maxlength="120"
                  placeholder="só o nome, se não tem conta"
                  class="min-w-0 flex-1 rounded-lg border border-ink-200 bg-ink-100/40 px-3 py-2.5 font-serif text-sm text-ink-800 placeholder:text-ink-400"
                />
              </div>
            </div>

            <p class="m-0 mt-1 text-[11.5px] leading-snug text-ink-400">
              Usuário que não existe é ignorado; nesse caso use o campo do nome.
            </p>
          </div>

          <%!-- When payment happens used to be free text, and free text is nothing
               the system can use: with a choice, the page can show the right way to
               pay and offer the receipt shortcut. Only shows on a paid workshop.
          --%>
          <div :if={@form["price"] not in ["", nil, "0"]} class="mb-5">
            <p class="mb-1 text-[12.5px] font-bold text-ink-700">Quando as pessoas pagam</p>
            <div class="flex flex-col gap-1.5">
              <label class="flex cursor-pointer items-start gap-2.5 rounded-xl border border-ink-200 bg-ink-100/40 px-3 py-2.5">
                <input
                  type="radio"
                  name="workshop[payment_mode]"
                  value="on_signup"
                  checked={@form["payment_mode"] == "on_signup"}
                  class="mt-0.5 size-4 shrink-0 accent-accent-orange"
                />
                <span>
                  <span class="block text-[13px] font-bold text-ink-900">Na inscrição</span>
                  <span class="block text-[11.5px] leading-snug text-ink-500">
                    A pessoa paga e manda o comprovante para você marcar como pago.
                  </span>
                </span>
              </label>
              <label class="flex cursor-pointer items-start gap-2.5 rounded-xl border border-ink-200 bg-ink-100/40 px-3 py-2.5">
                <input
                  type="radio"
                  name="workshop[payment_mode]"
                  value="at_event"
                  checked={@form["payment_mode"] == "at_event"}
                  class="mt-0.5 size-4 shrink-0 accent-accent-orange"
                />
                <span>
                  <span class="block text-[13px] font-bold text-ink-900">Na hora do evento</span>
                  <span class="block text-[11.5px] leading-snug text-ink-500">
                    Ninguém precisa pagar antes para garantir a vaga.
                  </span>
                </span>
              </label>
            </div>

            <div :if={@form["payment_mode"] == "on_signup"} class="mt-2.5">
              <label
                for="workshop-payment-phone"
                class="mb-1.5 block text-[10px] font-bold uppercase tracking-[1.3px] text-ink-500"
              >
                Telefone para receber o comprovante
              </label>
              <input
                id="workshop-payment-phone"
                type="tel"
                name="workshop[payment_phone]"
                phx-debounce="300"
                value={@form["payment_phone"]}
                maxlength="40"
                placeholder="(41) 99999-0000"
                class="w-full rounded-lg border border-ink-200 bg-ink-100/40 px-3 py-2.5 font-serif text-sm text-ink-800 placeholder:text-ink-400"
              />
              <p class="m-0 mt-1 text-[11.5px] leading-snug text-ink-500">
                Vira um botão de WhatsApp para quem se inscreveu, com o nome do workshop
                já na mensagem. Só quem está inscrito vê.
              </p>
            </div>
          </div>

          <p class="mb-1 text-[12.5px] font-bold text-ink-700">Quem enxerga</p>
          <div class="flex flex-col gap-1.5">
            <label class="flex cursor-pointer items-start gap-2.5 rounded-xl border border-ink-200 bg-ink-100/40 px-3 py-2.5">
              <input
                type="radio"
                name="workshop[visibility]"
                value="public"
                checked={@form["visibility"] != "private"}
                class="mt-0.5 size-4 shrink-0 accent-accent-orange"
              />
              <span>
                <span class="block text-[13px] font-bold text-ink-900">Público</span>
                <span class="block text-[11.5px] leading-snug text-ink-500">
                  Aparece na agenda da comunidade e qualquer um com o link se inscreve.
                </span>
              </span>
            </label>
            <label class="flex cursor-pointer items-start gap-2.5 rounded-xl border border-ink-200 bg-ink-100/40 px-3 py-2.5">
              <input
                type="radio"
                name="workshop[visibility]"
                value="private"
                checked={@form["visibility"] == "private"}
                class="mt-0.5 size-4 shrink-0 accent-accent-orange"
              />
              <span>
                <span class="block text-[13px] font-bold text-ink-900">Por convite</span>
                <span class="block text-[11.5px] leading-snug text-ink-500">
                  Não aparece na agenda, e só quem você convidar consegue abrir o link.
                </span>
              </span>
            </label>
          </div>
        </div>

        <.flyer_field upload={@uploads.flyer} current_path={@workshop && @workshop.flyer_path} />

        <p :if={@form_error} class="m-0 mb-3 text-xs font-semibold text-accent-red">
          {@form_error}
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-2.5">
          <button
            type="submit"
            name="publish"
            value="true"
            phx-disable-with="Publicando..."
            class="cursor-pointer rounded-full border-0 bg-accent-orange px-5 py-2.5 font-serif text-sm font-semibold text-white transition-colors hover:bg-accent-orange/90"
          >
            {if @workshop && @workshop.status == :published,
              do: "Salvar alterações",
              else: "Publicar workshop"}
          </button>
          <button
            :if={is_nil(@workshop) || @workshop.status == :draft}
            type="submit"
            name="publish"
            value="false"
            phx-disable-with="Salvando..."
            class="cursor-pointer rounded-full border border-ink-300 bg-ink-50 px-5 py-2.5 font-serif text-sm font-semibold text-ink-700"
          >
            Salvar rascunho
          </button>
          <.link
            navigate={~p"/study/workshops"}
            class="text-xs font-semibold text-ink-400 no-underline hover:text-ink-700"
          >
            Cancelar
          </.link>
        </div>
      </div>
    </form>
  </main>
</div>
