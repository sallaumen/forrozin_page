<div id="workshop-shell" class="min-h-screen bg-ink-100 font-serif flex flex-col">
  <.flash kind={:info} id="lv-flash-info" flash={@flash} />
  <.flash kind={:error} id="lv-flash-error" flash={@flash} />

  <%!-- An anonymous visitor gets a simple header with an invitation to sign in. --%>
  <header
    :if={is_nil(@current_user)}
    class="flex items-center justify-between bg-ink-900 px-5 py-3 text-ink-100"
  >
    <a
      href={~p"/"}
      class="brand-display text-[13px] font-bold uppercase tracking-[2.4px] text-ink-200 no-underline"
    >
      O Grupo de Estudos
    </a>
    <a
      href={~p"/login?#{[return_to: ~p"/workshops/#{@workshop.slug}"]}"}
      class="text-xs tracking-wider text-ink-400 no-underline"
    >
      Entrar →
    </a>
  </header>

  <.top_nav
    :if={@current_user}
    current_user={@current_user}
    is_admin={@is_admin}
    nav_mode={:detail}
    title="Workshop"
  />

  <main class="mx-auto w-full max-w-[1000px] flex-1 px-4 py-6 sm:px-6">
    <.link
      :if={@current_user}
      navigate={~p"/study/workshops"}
      class="mb-4 inline-flex items-center gap-1.5 text-[13px] font-semibold text-ink-500 no-underline hover:text-ink-800"
    >
      <.icon name="hero-arrow-left" class="size-4" /> Workshops
    </.link>

    <div :if={@workshop.status == :cancelled} class="mb-4 rounded-xl bg-accent-red/10 px-4 py-3">
      <p class="m-0 text-[13px] font-bold text-accent-red">
        Este workshop foi cancelado pelo organizador.
      </p>
    </div>

    <div :if={@workshop.status == :draft} class="mb-4 rounded-xl bg-gold-500/15 px-4 py-3">
      <p class="m-0 text-[13px] font-bold text-ink-700">
        Rascunho: só você enxerga esta página até publicar.
      </p>
    </div>

    <div class="flex flex-wrap items-start justify-between gap-4 border-b border-ink-200 pb-5">
      <div class="min-w-0">
        <.workshop_tag :if={@workshop.visibility == :private} tone={:gold}>
          <.icon name="hero-lock-closed" class="mr-1 size-3" /> Entrada por aprovação
        </.workshop_tag>
        <h1 class="m-0 font-serif text-[26px] font-bold tracking-tight text-ink-900 sm:text-[30px]">
          {@workshop.title}
        </h1>
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13.5px] text-ink-600">
          <span class="font-bold text-ink-900">{schedule_label(@workshop)}</span>
          <span :if={Workshop.place_line(@workshop)}>{Workshop.place_line(@workshop)}</span>
          <%!-- "com" names who teaches, not who organizes: with the two roles
               separated, crediting the class to whoever only produced it became a
               bug.
          --%>
          <span>com <b class="text-ink-900">{teacher_names(@teachers)}</b></span>
        </div>

        <%!-- The full address sits with the title and not buried in the description:
             whoever opens the page on a phone is often already on the way. --%>
        <p
          :if={Workshop.address_line(@workshop)}
          class="m-0 mt-2 flex items-start gap-1.5 text-[13px] leading-snug text-ink-500"
        >
          <.icon name="hero-map-pin" class="mt-0.5 size-4 shrink-0 text-ink-400" />
          {Workshop.address_line(@workshop)}
        </p>
      </div>
      <.link
        :if={@organizer?}
        navigate={~p"/workshops/#{@workshop.slug}/manage"}
        class="shrink-0 rounded-full border border-ink-300 bg-ink-50 px-4 py-2 font-serif text-[13px] font-semibold text-ink-700 no-underline"
      >
        Gerenciar inscritos
      </.link>
    </div>

    <%!-- DOM order is the mobile order: flyer, price and enrollment before
         everything. On desktop the columns go back in place through `order`, with no
         duplicated markup. Without this the box falls to 79% of the height on a
         small screen, after the whole conversation.
    --%>
    <div class="mt-5 grid gap-5 lg:grid-cols-[1.6fr_1fr]">
      <aside class="lg:order-2">
        <img
          :if={@workshop.flyer_path}
          src={@workshop.flyer_path}
          alt={"Flyer de #{@workshop.title}"}
          class="mb-4 w-full rounded-2xl border border-ink-200 object-cover shadow-sm"
        />
        <div class="rounded-2xl border border-ink-200 border-l-[3px] border-l-accent-green bg-ink-50 p-4 shadow-sm">
          <p class="m-0 font-serif text-[24px] font-bold tracking-tight text-ink-900">
            {price_label(@workshop)}
            <span :if={!Workshop.free?(@workshop)} class="text-[12px] font-normal text-ink-500">
              por pessoa
            </span>
          </p>
          <p
            :if={!Workshop.free?(@workshop)}
            class="m-0 mt-1 text-[12.5px] leading-snug text-ink-500"
          >
            {payment_hint(@workshop, @enrolled? || @organizer?)}
          </p>

          <%!-- Receipt button: only for whoever is already in the class, the same
               criterion as the Pix key. Sending the receipt stops being copy the
               number and write which workshop it is about.
          --%>
          <a
            :if={@enrolled? && Workshop.receipt_link(@workshop)}
            href={Workshop.receipt_link(@workshop)}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 flex w-full items-center justify-center gap-1.5 rounded-full border border-accent-green/40 bg-accent-green/10 px-4 py-2 font-serif text-[13px] font-semibold text-accent-green no-underline"
          >
            <.icon name="hero-paper-airplane" class="size-4" /> Mandar comprovante
          </a>

          <%!-- Seats, only when the organizer set a capacity. --%>
          <div :if={@workshop.capacity} class="mt-3">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-ink-200">
              <div
                class="h-full rounded-full bg-accent-green"
                style={"width: #{seats_percent(@enrolled_count, @workshop.capacity)}%"}
              >
              </div>
            </div>
            <p class="m-0 mt-1.5 text-[12px] text-ink-600">
              <b>{@enrolled_count} de {@workshop.capacity}</b> vagas preenchidas
            </p>
          </div>

          <p
            :if={is_nil(@workshop.capacity) && @enrolled_count > 0}
            class="m-0 mt-3 text-[12px] text-ink-600"
          >
            <b>{people_label(@enrolled_count)}</b>
          </p>

          <button
            type="button"
            phx-click="toggle_workshop_like"
            aria-pressed={to_string(@liked?)}
            class={[
              "mt-3 flex w-full cursor-pointer items-center justify-center gap-1.5 rounded-full border px-4 py-2 font-serif text-[13px] font-semibold transition-colors",
              @liked? && "border-accent-red/40 bg-accent-red/10 text-accent-red",
              !@liked? && "border-ink-300 bg-ink-50 text-ink-600 hover:border-ink-400"
            ]}
          >
            <.icon name={if @liked?, do: "hero-heart-solid", else: "hero-heart"} class="size-4" />
            {like_label(@liked?, @like_count)}
          </button>

          <div class="mt-4">
            <%!-- The organizer is already at the event: enrolling would take a seat
                 and show up in their own payment list.
            --%>
            <.link
              :if={@organizer?}
              navigate={~p"/workshops/#{@workshop.slug}/manage"}
              class="block w-full rounded-full bg-ink-900 px-5 py-3 text-center font-serif text-[15px] font-semibold text-ink-50 no-underline"
            >
              Gerenciar inscritos
            </.link>

            <%!-- A private workshop swaps direct enrollment for a request: the door
                 goes through the organizer.
            --%>
            <button
              :if={can_ask_to_join?(@workshop, @organizer?, @enrolled?, @join_status, @full?)}
              type="button"
              phx-click="request_join"
              phx-disable-with="Enviando..."
              class="w-full cursor-pointer rounded-full border-0 bg-gold-600 px-5 py-3 font-serif text-[15px] font-semibold text-white transition-colors hover:bg-gold-500"
            >
              Pedir para entrar
            </button>

            <div
              :if={@join_status == :pending && !@enrolled?}
              class="rounded-xl border border-gold-500/40 bg-gold-500/12 px-4 py-3"
            >
              <p class="m-0 text-[13px] font-bold text-ink-800">
                <.icon name="hero-clock" class="size-4 -mt-0.5" /> Seu pedido foi enviado
              </p>
              <p class="m-0 mt-1 text-[12px] leading-snug text-ink-600">
                Assim que {@workshop.organizer.name} aceitar, a página abre inteira e você
                recebe um aviso no sino.
              </p>
            </div>

            <button
              :if={
                !@organizer? && !@enrolled? && !@full? && @workshop.status == :published &&
                  @workshop.visibility == :public
              }
              type="button"
              phx-click="enroll"
              phx-disable-with="Inscrevendo..."
              class="w-full cursor-pointer rounded-full border-0 bg-accent-orange px-5 py-3 font-serif text-[15px] font-semibold text-white transition-colors hover:bg-accent-orange/90"
            >
              Fazer inscrição
            </button>

            <div
              :if={@enrolled?}
              class="rounded-xl border border-accent-green/30 bg-accent-green/10 px-4 py-3 text-center"
            >
              <p class="m-0 text-[13px] font-bold text-accent-green">
                <.icon name="hero-check-circle" class="size-4 -mt-0.5" /> Você está inscrito
              </p>
              <button
                type="button"
                phx-click="cancel_enrollment"
                data-confirm="Cancelar sua inscrição neste workshop?"
                class="mt-1.5 cursor-pointer border-0 bg-transparent p-0 text-[11.5px] text-ink-500 underline"
              >
                cancelar inscrição
              </button>
            </div>

            <%!-- A full class stops being a dead end: the person joins the waitlist.
                 Without it, whoever was interested vanished without a trace, and
                 that number is exactly what says whether another class fits.
            --%>
            <div :if={
              shows_waitlist?(@workshop, @organizer?, @enrolled?, @full?, @waitlist_entry)
            }>
              <p class="m-0 mb-2 rounded-xl bg-ink-200 px-4 py-2.5 text-center text-[13px] font-bold text-ink-600">
                Vagas esgotadas
              </p>
              <button
                type="button"
                phx-click="join_waitlist"
                phx-disable-with="Entrando..."
                class="w-full cursor-pointer rounded-full border border-ink-900 bg-ink-50 px-5 py-3 font-serif text-[15px] font-semibold text-ink-900"
              >
                Entrar na lista de espera
              </button>
              <p :if={@waitlist_total > 0} class="m-0 mt-1.5 text-center text-[12px] text-ink-500">
                {waitlist_label(@waitlist_total)}
              </p>
            </div>

            <div
              :if={@waitlist_entry && !@enrolled?}
              class="rounded-xl border border-ink-300 bg-ink-100 px-4 py-3 text-center"
            >
              <p class="m-0 text-[13px] font-bold text-ink-800">
                <.icon name="hero-queue-list" class="size-4 -mt-0.5" />
                Você é {@waitlist_entry}º da lista de espera
              </p>
              <p class="m-0 mt-1 text-[12px] leading-snug text-ink-600">
                Se alguém cancelar, a vaga é sua e você recebe um aviso.
              </p>
              <button
                type="button"
                phx-click="leave_waitlist"
                class="mt-1.5 cursor-pointer border-0 bg-transparent p-0 text-[11.5px] text-ink-500 underline"
              >
                sair da lista
              </button>
            </div>
          </div>
        </div>

        <%!-- The face of whoever teaches: it introduces the teacher and leads to
             their profile, which is where the name circulates.
        --%>
        <div class="mt-3 rounded-xl border border-ink-200 bg-ink-50/60 px-4 py-3">
          <p class="m-0 mb-2 text-[11px] font-bold uppercase tracking-[2px] text-ink-500">
            Quem dá a aula
          </p>
          <%!-- A teacher without an account comes in as a name only: waiting for the
               account to exist before announcing the class would hold up the real
               world for the database. No account means no profile, so no link.
          --%>
          <.link
            :for={teacher <- Enum.filter(@teachers, & &1.username)}
            navigate={~p"/users/#{teacher.username}"}
            class="flex items-center gap-2.5 py-1 no-underline"
          >
            <.user_avatar user={teacher} size={:md} />
            <span class="min-w-0">
              <span class="block truncate text-[13.5px] font-bold text-ink-900">
                {teacher.name || teacher.username}
              </span>
              <span class="block truncate text-[12px] text-ink-500">@{teacher.username}</span>
            </span>
          </.link>

          <div
            :for={teacher <- Enum.reject(@teachers, & &1.username)}
            class="flex items-center gap-2.5 py-1"
          >
            <.user_avatar user={teacher} size={:md} />
            <span class="block truncate text-[13.5px] font-bold text-ink-900">
              {teacher.name}
            </span>
          </div>
        </div>
      </aside>

      <div class="lg:order-1">
        <div class="whitespace-pre-line text-[14.5px] leading-relaxed text-ink-800">
          {@workshop.description}
        </div>

        <%!-- Storefront: whoever has not entered sees the shape of what is inside,
             never the content. Hiding it would say "there is nothing here"; showing
             it would give away what is paid for. Blurred with the count underneath
             says the only thing that matters from outside: there are people in here.
        --%>
        <.locked_preview
          :if={@storefront?}
          enrolled_count={@enrolled_count}
          comment_count={length(@comments)}
        />

        <%!-- Steps taught in the class: the missing link between the workshop and the
             collection. A click opens the step sheet, with the learn gesture,
             without leaving this page.
        --%>
        <section :if={!@storefront? && (@steps != [] || @organizer?)} class="mt-7">
          <h2 class="m-0 mb-2.5 text-[11px] font-bold uppercase tracking-[2px] text-ink-500">
            Passos desta aula
          </h2>

          <p :if={@steps == []} class="m-0 mb-2 text-[13px] text-ink-500">
            Nenhum passo marcado ainda. Vincule o que foi dado para quem esteve na aula
            achar depois.
          </p>

          <div class="flex flex-wrap gap-2">
            <%!-- Light green for what the person already knows, amber for what they
                 do not: looking at the class list now says something about their own
                 learning, without opening step by step.
            --%>
            <span
              :for={step <- @steps}
              class={[
                "inline-flex items-center rounded-full border text-[11.5px] font-semibold",
                MapSet.member?(@learned_codes, step.code) &&
                  "border-accent-green/30 bg-accent-green/[0.10] text-accent-green",
                !MapSet.member?(@learned_codes, step.code) &&
                  "border-accent-orange/25 bg-accent-orange/[0.08] text-accent-orange"
              ]}
            >
              <button
                type="button"
                phx-click="open_step_sheet"
                phx-value-code={step.code}
                class="inline-flex cursor-pointer items-center gap-1.5 rounded-l-full py-1 pl-2.5 pr-2 transition-colors hover:brightness-95"
              >
                <.icon
                  :if={MapSet.member?(@learned_codes, step.code)}
                  name="hero-check-circle-solid"
                  class="size-3"
                />
                <code class="font-bold">{step.code}</code>
                <span class="font-normal text-ink-600">{step.name}</span>
              </button>
              <button
                :if={@organizer?}
                type="button"
                phx-click="remove_workshop_step"
                phx-value-id={step.step_id}
                aria-label={"Tirar #{step.code} da lista"}
                class="group cursor-pointer rounded-r-full py-1 pl-1 pr-2.5"
              >
                <.icon name="hero-x-mark" class="size-3 opacity-60 group-hover:opacity-100" />
              </button>
              <span :if={!@organizer?} class="rounded-r-full py-1 pr-2"></span>
            </span>
          </div>

          <%!-- Only an admin builds the list: it is what the class offered, and
               whoever taught it knows what they offered.
          --%>
          <div :if={@organizer?} class="relative mt-2.5 max-w-[22rem]">
            <input
              type="text"
              name="term"
              phx-change="search_workshop_step"
              phx-debounce="200"
              autocomplete="off"
              placeholder="+ Vincular passo dado nesta aula"
              class="w-full rounded-full border border-ink-300 bg-ink-50 px-4 py-2 font-serif text-[13px] text-ink-800 placeholder:text-ink-400"
            />
            <div
              :if={@step_search != []}
              class="absolute z-20 mt-1 w-full overflow-hidden rounded-xl border border-ink-200 bg-ink-50 shadow-md"
            >
              <button
                :for={suggestion <- @step_search}
                type="button"
                phx-click="add_workshop_step"
                phx-value-id={suggestion.id}
                class="flex w-full cursor-pointer items-center gap-2 border-0 border-b border-ink-200 bg-transparent px-3 py-2 text-left text-[13px] last:border-b-0 hover:bg-ink-100"
              >
                <code class="font-bold text-accent-orange">{suggestion.code}</code>
                <span class="text-ink-700">{suggestion.name}</span>
              </button>
            </div>
          </div>
        </section>

        <%!-- The step list is not a sequence: a class teaches one or two names and
             the combination is a separate thing. Whoever teaches cites the refined
             one here; whoever attends takes it home by favoriting.
        --%>
        <section
          :if={!@storefront? && (@workshop_sequences != [] || @organizer?)}
          class="mt-7"
        >
          <h2 class="m-0 mb-2.5 text-[11px] font-bold uppercase tracking-[2px] text-ink-500">
            Sequências desta aula
          </h2>

          <p :if={@workshop_sequences == []} class="m-0 mb-2 text-[13px] text-ink-500">
            Nenhuma sequência ainda. Monte a combinação que você deu para quem esteve
            aqui levar pra casa.
          </p>

          <div class="flex flex-col gap-2">
            <div
              :for={cited <- @workshop_sequences}
              class="rounded-xl border border-gold-500/35 bg-gold-500/[0.07]"
            >
              <div class="flex items-center gap-1 px-1.5 py-1">
                <button
                  type="button"
                  phx-click="toggle_sequence_steps"
                  phx-value-id={cited.sequence_id}
                  aria-expanded={
                    to_string(@open_sequence && @open_sequence.id == cited.sequence_id)
                  }
                  class="flex min-h-9 flex-1 cursor-pointer items-center gap-2 rounded-lg px-2 text-left text-[13px] font-semibold text-ink-800 hover:bg-gold-500/[0.10]"
                >
                  <span class="text-[11px] font-bold text-gold-600">→</span>
                  {cited.name}
                  <span class="text-[10.5px] font-medium text-ink-500">
                    {cited.step_count} {if cited.step_count == 1, do: "passo", else: "passos"}
                  </span>
                </button>

                <button
                  :if={@current_user}
                  type="button"
                  phx-click="toggle_sequence_favorite"
                  phx-value-id={cited.sequence_id}
                  aria-label={"Favoritar #{cited.name}"}
                  class="grid size-9 cursor-pointer place-items-center rounded-lg text-ink-400 hover:bg-gold-500/[0.10] hover:text-gold-600"
                >
                  <.icon
                    name={
                      if MapSet.member?(@sequence_favorites, cited.sequence_id),
                        do: "hero-heart-solid",
                        else: "hero-heart"
                    }
                    class={[
                      "size-4",
                      MapSet.member?(@sequence_favorites, cited.sequence_id) && "text-gold-600"
                    ]}
                  />
                </button>

                <button
                  :if={@organizer?}
                  type="button"
                  phx-click="uncite_sequence"
                  phx-value-id={cited.sequence_id}
                  aria-label={"Tirar #{cited.name} desta aula"}
                  class="grid size-9 cursor-pointer place-items-center rounded-lg text-ink-400 hover:bg-gold-500/[0.10] hover:text-ink-700"
                >
                  <.icon name="hero-x-mark" class="size-3.5" />
                </button>
              </div>

              <div
                :if={@open_sequence && @open_sequence.id == cited.sequence_id}
                class="flex flex-wrap items-center gap-1.5 border-t border-gold-500/25 px-3 py-2.5"
              >
                <span
                  :for={{sequence_step, index} <- Enum.with_index(@open_sequence.sequence_steps)}
                  data-sequence-step={sequence_step.step.code}
                  class="inline-flex items-center gap-1.5 text-[12px]"
                >
                  <span :if={index > 0} class="text-[11px] font-bold text-gold-600">→</span>
                  <code class="font-bold text-accent-orange">{sequence_step.step.code}</code>
                  <span class="text-ink-600">{sequence_step.step.name}</span>
                </span>
              </div>
            </div>
          </div>

          <div :if={@organizer?} class="mt-2.5 flex flex-wrap gap-2">
            <button
              type="button"
              phx-click="open_sequence_sheet"
              phx-value-tab="new"
              class="inline-flex min-h-9 cursor-pointer items-center gap-1.5 rounded-full border border-dashed border-ink-300 px-3.5 text-[12.5px] font-semibold text-ink-600 transition hover:border-gold-500 hover:bg-gold-500/[0.06] hover:text-gold-600"
            >
              <span aria-hidden="true">→</span> montar sequência
            </button>
            <button
              type="button"
              phx-click="open_sequence_sheet"
              phx-value-tab="mine"
              class="inline-flex min-h-9 cursor-pointer items-center rounded-full border border-ink-200 px-3.5 text-[12.5px] font-semibold text-ink-600 transition hover:border-gold-500 hover:text-gold-600"
            >
              citar uma minha
            </button>
          </div>
        </section>

        <section :if={!@storefront? && @current_user && @participants != []} class="mt-7">
          <h2 class="m-0 mb-2.5 text-[11px] font-bold uppercase tracking-[2px] text-ink-500">
            Quem vai
          </h2>
          <div class="flex flex-wrap gap-2">
            <span
              :for={p <- @participants}
              class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-ink-50 py-1 pl-1 pr-3"
            >
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-ink-900 text-[10px] font-bold text-ink-50">
                {String.first(p.name || p.username)}
              </span>
              <span class="text-[12.5px] text-ink-700">{p.name}</span>
            </span>
          </div>
        </section>

        <p
          :if={is_nil(@current_user) && @enrolled_count > 0}
          class="mt-6 text-[13px] text-ink-500"
        >
          {people_label(@enrolled_count)} até agora.
          <a
            href={~p"/login?#{[return_to: ~p"/workshops/#{@workshop.slug}"]}"}
            class="font-semibold text-accent-orange"
          >
            Entre
          </a>
          para ver quem vai.
        </p>

        <%!-- Gallery: only for whoever is in the workshop. --%>
        <section :if={!@storefront? && @can_see_media?} class="mt-8 border-t border-ink-200 pt-6">
          <h2 class="m-0 mb-1 text-[11px] font-bold uppercase tracking-[2px] text-ink-500">
            Fotos e vídeos
          </h2>
          <p class="m-0 mb-3 text-[12.5px] text-ink-500">
            Só quem está no workshop vê e manda. O que vem de quem dá a aula aparece primeiro.
          </p>

          <.media_gallery
            :if={@media != []}
            media={@media}
            current_user={@current_user}
            can_delete_any={@organizer? || false}
          />

          <p :if={@media == []} class="m-0 mb-3 text-[13px] text-ink-500">
            Nada aqui ainda. Mande a primeira foto ou o primeiro vídeo do workshop.
          </p>

          <form id="media-form" phx-submit="upload_media" phx-change="validate_media" class="mt-3">
            <%!-- The native input stays hidden (sr-only, not display:none, which
                 would take it out of the keyboard path) and the label becomes the
                 button: the text of the native control belongs to the browser, and
                 comes out in English.
            --%>
            <label
              for={@uploads.media.ref}
              class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-ink-900 px-4 py-2 font-serif text-[12.5px] font-semibold text-ink-50"
            >
              <.icon name="hero-arrow-up-tray" class="size-4" /> Escolher foto ou vídeo
            </label>
            <.live_file_input upload={@uploads.media} class="sr-only" />

            <div :for={entry <- @uploads.media.entries} class="mt-2 flex items-center gap-3">
              <span class="text-[12px] text-ink-500">{entry.client_name}</span>
              <span class="text-[12px] font-bold text-ink-700">{entry.progress}%</span>
            </div>

            <div :for={entry <- @uploads.media.entries}>
              <p
                :for={error <- upload_errors(@uploads.media, entry)}
                class="m-0 mt-1 text-[12px] font-semibold text-accent-red"
              >
                {media_upload_error(error)}
              </p>
            </div>

            <button
              :if={@uploads.media.entries != []}
              type="submit"
              phx-disable-with="Enviando..."
              class="mt-2 cursor-pointer rounded-full border-0 bg-accent-orange px-4 py-2 font-serif text-[13px] font-semibold text-white"
            >
              Enviar para a galeria
            </button>
          </form>
        </section>

        <%!-- Conversa: aberta a leitura, escrita exige conta --%>
        <section :if={!@storefront?} class="mt-8 border-t border-ink-200 pt-6">
          <h2 class="m-0 mb-3 text-[11px] font-bold uppercase tracking-[2px] text-ink-500">
            Conversa
          </h2>

          <p :if={@comments == []} class="m-0 mb-3 text-[13px] text-ink-500">
            Ninguém comentou ainda. Dúvida sobre horário, nível ou o que levar? Pergunte aqui.
          </p>

          <.comment_thread
            comments={@comments}
            current_user={@current_user}
            likes_map={@comment_likes}
            comment_type="workshop_comment"
            parent_id={@workshop.id}
            replying_to={@replying_to}
            replies_map={@replies_map}
            is_admin={@is_admin || false}
            badges={@comment_badges}
            show_form={@can_comment?}
          >
            <:form_placeholder>
              <p :if={@workshop.status == :draft} class="m-0 text-[13px] text-ink-500">
                A conversa abre quando você publicar o workshop.
              </p>
              <p :if={@workshop.status != :draft} class="m-0 text-[13px] text-ink-500">
                <.link
                  navigate={~p"/login?#{[return_to: ~p"/workshops/#{@workshop.slug}"]}"}
                  class="font-semibold text-accent-orange"
                >
                  Entre para comentar
                </.link>
                e falar com quem vai.
              </p>
            </:form_placeholder>
          </.comment_thread>
        </section>
      </div>
    </div>
  </main>
</div>

<.step_sheet step={@step_sheet} learned={@step_sheet_learned} />
<.sequence_sheet
  tab={@sequence_sheet}
  draft_steps={@sequence_draft_steps}
  draft_name={@sequence_draft_name}
  search_term={@sequence_search_term}
  step_matches={@sequence_step_matches}
  mine={@sequence_mine}
  cited_ids={MapSet.new(@workshop_sequences, & &1.sequence_id)}
/>
