<div id="workshop-shell" class="min-h-screen bg-ink-100 font-serif flex flex-col">
  <.flash kind={:info} id="lv-flash-info" flash={@flash} />
  <.flash kind={:error} id="lv-flash-error" flash={@flash} />

  <%!-- An anonymous visitor gets a simple header with an invitation to sign in. --%>
  <header
    :if={is_nil(@current_user)}
    class="flex items-center justify-between bg-ink-900 px-5 py-3 text-ink-100"
  >
    <a
      href={~p"/"}
      class="brand-display text-[13px] font-bold uppercase tracking-[2.4px] text-ink-200 no-underline"
    >
      O Grupo de Estudos
    </a>
    <a
      href={~p"/login?#{[return_to: ~p"/workshops/#{@workshop.slug}"]}"}
      class="text-xs tracking-wider text-ink-400 no-underline"
    >
      Entrar →
    </a>
  </header>

  <%!-- Um workshop é lugar, não tarefa: a pessoa chegou tocando num card de uma
       lista. Trocar o app inteiro por uma barra de "Voltar" tirava junto o sino e
       o perfil, e ainda repetia o "← Workshops" que já vive na página. --%>
  <.top_nav
    :if={@current_user}
    current_user={@current_user}
    is_admin={@is_admin}
    nav_mode={@nav_mode}
    notification_count={assigns[:notification_count] || 0}
    pending_suggestions_count={assigns[:pending_suggestions_count] || 0}
  />

  <%!-- The state of the whole page is a band across it: a floating card would be
       one more item competing with the class itself. --%>
  <p
    :if={@workshop.status == :cancelled}
    class="m-0 border-b border-accent-red/25 bg-accent-red/[0.07] px-4 py-2.5 text-center font-sans text-[12.5px] font-semibold text-accent-red"
  >
    Este workshop foi cancelado pelo organizador.
  </p>

  <p
    :if={@workshop.status == :draft}
    class="m-0 border-b border-gold-500/30 bg-gold-500/10 px-4 py-2.5 text-center font-sans text-[12.5px] text-ink-700"
  >
    Rascunho: só você enxerga esta página até publicar.
  </p>

  <%!-- pb-24 reserva a altura da barra de abas: sem isso o último bloco fica
       embaixo dela no celular. --%>
  <main class="mx-auto w-full max-w-[1020px] flex-1 px-4 py-6 pb-24 sm:px-6 sm:py-8 md:pb-8">
    <.link
      :if={@current_user}
      navigate={~p"/study/workshops"}
      class="mb-3 inline-flex min-h-11 items-center gap-1.5 font-sans text-[12.5px] font-semibold text-ink-500 no-underline hover:text-ink-800 sm:mb-5 sm:min-h-0"
    >
      <.icon name="hero-arrow-left" class="size-4" /> Workshops
    </.link>

    <%!-- O cartaz abre a página do mesmo jeito que abre a da programação: é ele
         que circulou no WhatsApp. Na coluna da direita ele empurrava a ficha para
         600px de altura e abria um vazio embaixo do conteúdo. --%>
    <header class="flex flex-col gap-5 border-b border-ink-200 pb-6 sm:flex-row sm:items-start sm:gap-7">
      <img
        :if={@workshop.flyer_path}
        src={@workshop.flyer_path}
        alt={"Flyer de #{@workshop.title}"}
        class="w-[52%] max-w-[230px] shrink-0 self-start rounded-lg border border-ink-200 object-cover shadow-sm sm:w-[210px] sm:max-w-none"
      />

      <div class="min-w-0 flex-1">
        <.editable
          field={:title}
          label="título"
          editing={@editing_field}
          can_edit={@organizer?}
          value={InlineEditParams.form_value(@workshop, :title)}
          error={@edit_error}
        >
          <h1 class="brand-display is-title m-0 text-[27px] font-semibold leading-[1.14] tracking-tight text-ink-900 sm:text-[33px]">
            {@workshop.title}
          </h1>
        </.editable>

        <%!-- Quando, onde e com quem, uma coisa por linha. A mesma informação numa
           linha só, separada por pontos, vira um caminho de arquivo: o olho não
           acha o horário nem o endereço. --%>
        <div class="mt-3.5 font-sans text-[13.5px] leading-relaxed text-ink-600">
          <.editable
            field={:starts_at}
            label="quando começa"
            type={:datetime}
            editing={@editing_field}
            can_edit={@organizer?}
            value={InlineEditParams.form_value(@workshop, :starts_at)}
            hint="A duração da aula é mantida: o fim anda junto."
            error={@edit_error}
          >
            <span class="font-semibold text-ink-900">{schedule_label(@workshop)}</span>
          </.editable>

          <.editable
            field={:location}
            label="nome do lugar"
            editing={@editing_field}
            can_edit={@organizer?}
            value={InlineEditParams.form_value(@workshop, :location)}
            error={@edit_error}
          >
            <span>{Workshop.place_line(@workshop) || "sem lugar definido"}</span>
          </.editable>

          <%!-- The full address sits with the title and not buried in the description:
             whoever opens the page on a phone is often already on the way. --%>
          <.editable_address
            :if={Workshop.address_line(@workshop) || @organizer?}
            field={:address}
            label="endereço"
            editing={@editing_field}
            can_edit={@organizer?}
            workshop={@workshop}
            states={Brazil.states()}
            error={@edit_error}
          >
            <%!-- Sem endereço a linha vira recado para quem organiza, não um fato
               da página: menor, ela não disputa com o nome do lugar. --%>
            <p class={[
              "m-0 text-ink-500",
              is_nil(Workshop.address_line(@workshop)) && "text-[12.5px]"
            ]}>
              {Workshop.address_line(@workshop) || "endereço não preenchido"}
            </p>
          </.editable_address>

          <%!-- "com" names who teaches, not who organizes: with the two roles
             separated, crediting the class to whoever only produced it became a
             bug.
        --%>
          <p class="m-0">
            com <b class="font-semibold text-ink-900">{teacher_names(@teachers)}</b>
          </p>

          <p
            :if={@workshop.visibility == :private}
            class="m-0 mt-1 flex items-center gap-1.5 text-[12.5px] text-gold-600"
          >
            <.icon name="hero-lock-closed" class="size-3.5" /> Entrada por aprovação
          </p>
        </div>
      </div>
    </header>

    <%!-- DOM order is the mobile order: price and enrollment before everything
         else. On desktop the columns go back in place through `order`, with no
         duplicated markup. Without this the ficha falls to 79% of the height on a
         small screen, after the whole conversation.
    --%>
    <div class="mt-6 grid gap-7 lg:grid-cols-[1.55fr_1fr] lg:gap-9">
      <%!-- A ficha, não um cartão: o que separa a coluna prática do conteúdo é um
           fio, e dentro dela os assuntos se separam por outros fios. Caixa dentro
           de caixa era o que fazia o preço, o comprovante e as vagas brigarem. --%>
      <aside class="lg:order-2 lg:border-l lg:border-ink-300 lg:pl-8">
        <p class="brand-display is-title m-0 text-[30px] font-semibold leading-none tracking-tight text-ink-900">
          {price_label(@workshop)}
          <span
            :if={!Workshop.free?(@workshop)}
            class="font-serif text-[13px] font-normal text-ink-500"
          >
            por pessoa
          </span>
        </p>
        <p
          :if={!Workshop.free?(@workshop)}
          class="m-0 mt-1.5 font-sans text-[12.5px] leading-snug text-ink-500"
        >
          {payment_hint(@workshop, @enrolled? || @organizer?)}
        </p>

        <%!-- Seats, only when the organizer set a capacity. --%>
        <div :if={@workshop.capacity} class="mt-4">
          <div class="h-1 w-full overflow-hidden rounded-full bg-ink-200">
            <div
              class="h-full rounded-full bg-ink-500"
              style={"width: #{seats_percent(@enrolled_count, @workshop.capacity)}%"}
            >
            </div>
          </div>
          <p class="m-0 mt-1.5 font-sans text-[12px] text-ink-500">
            <b class="font-semibold text-ink-700">{@enrolled_count} de {@workshop.capacity}</b>
            vagas preenchidas
          </p>
        </div>

        <p
          :if={is_nil(@workshop.capacity) && @enrolled_count > 0}
          class="m-0 mt-4 font-sans text-[12px] font-semibold text-ink-700"
        >
          {people_label(@enrolled_count)}
        </p>

        <div class="mt-5">
          <%!-- The organizer is already at the event: enrolling would take a seat
               and show up in their own payment list.
          --%>
          <.link
            :if={@organizer?}
            navigate={~p"/workshops/#{@workshop.slug}/manage"}
            class="block w-full rounded-full bg-ink-900 px-5 py-3 text-center font-serif text-[15px] font-semibold text-ink-50 no-underline"
          >
            Gerenciar inscritos
          </.link>

          <%!-- A private workshop swaps direct enrollment for a request: the door
               goes through the organizer.
          --%>
          <button
            :if={can_ask_to_join?(@workshop, @organizer?, @enrolled?, @join_status, @full?)}
            type="button"
            phx-click="request_join"
            phx-disable-with="Enviando..."
            class="w-full cursor-pointer rounded-full border-0 bg-accent-orange px-5 py-3 font-serif text-[15px] font-semibold text-on-accent transition-colors hover:bg-accent-orange/90"
          >
            Pedir para entrar
          </button>

          <div :if={@join_status == :pending && !@enrolled?}>
            <p class="m-0 flex items-center gap-1.5 font-sans text-[13px] font-semibold text-ink-800">
              <.icon name="hero-clock" class="size-4 text-gold-600" /> Seu pedido foi enviado
            </p>
            <p class="m-0 mt-1 font-sans text-[12px] leading-snug text-ink-500">
              Assim que {@workshop.organizer.name} aceitar, a página abre inteira e você
              recebe um aviso no sino.
            </p>
          </div>

          <button
            :if={
              !@organizer? && !@enrolled? && !@full? && @workshop.status == :published &&
                @workshop.visibility == :public
            }
            type="button"
            phx-click="enroll"
            phx-disable-with="Inscrevendo..."
            class="w-full cursor-pointer rounded-full border-0 bg-accent-orange px-5 py-3 font-serif text-[15px] font-semibold text-on-accent transition-colors hover:bg-accent-orange/90"
          >
            Fazer inscrição
          </button>

          <%!-- Estar inscrito é um fato, não um alarme: uma marca e a saída ao lado,
               em vez de borda, fundo, ícone e negrito dizendo a mesma coisa. --%>
          <p
            :if={@enrolled?}
            class="m-0 flex flex-wrap items-center gap-x-2 font-sans text-[13px]"
          >
            <span class="inline-flex items-center gap-1.5 font-semibold text-ink-800">
              <.icon name="hero-check-circle-solid" class="size-4 text-accent-green" />
              Você está inscrito
            </span>
            <button
              type="button"
              phx-click="cancel_enrollment"
              data-confirm="Cancelar sua inscrição neste workshop?"
              class="inline-flex min-h-11 cursor-pointer items-center border-0 bg-transparent p-0 text-[12px] text-ink-500 underline sm:min-h-0"
            >
              cancelar
            </button>
          </p>

          <%!-- A full class stops being a dead end: the person joins the waitlist.
               Without it, whoever was interested vanished without a trace, and
               that number is exactly what says whether another class fits.
          --%>
          <div :if={shows_waitlist?(@workshop, @organizer?, @enrolled?, @full?, @waitlist_entry)}>
            <p class="m-0 mb-2 font-sans text-[13px] font-semibold text-accent-red">
              Vagas esgotadas
            </p>
            <button
              type="button"
              phx-click="join_waitlist"
              phx-disable-with="Entrando..."
              class="w-full cursor-pointer rounded-full border border-ink-900 bg-transparent px-5 py-3 font-serif text-[15px] font-semibold text-ink-900"
            >
              Entrar na lista de espera
            </button>
            <p :if={@waitlist_total > 0} class="m-0 mt-1.5 font-sans text-[12px] text-ink-500">
              {waitlist_label(@waitlist_total)}
            </p>
          </div>

          <div :if={@waitlist_entry && !@enrolled?}>
            <p class="m-0 flex items-center gap-1.5 font-sans text-[13px] font-semibold text-ink-800">
              <.icon name="hero-queue-list" class="size-4 text-ink-500" />
              Você é {@waitlist_entry}º da lista de espera
            </p>
            <p class="m-0 mt-1 font-sans text-[12px] leading-snug text-ink-500">
              Se alguém cancelar, a vaga é sua e você recebe um aviso.
            </p>
            <button
              type="button"
              phx-click="leave_waitlist"
              class="inline-flex min-h-11 cursor-pointer items-center border-0 bg-transparent p-0 font-sans text-[12px] text-ink-500 underline sm:min-h-0"
            >
              sair da lista
            </button>
          </div>

          <button
            type="button"
            phx-click="toggle_workshop_like"
            aria-pressed={to_string(@liked?)}
            class={[
              "mt-3 inline-flex min-h-11 cursor-pointer items-center gap-1.5 border-0 bg-transparent p-0 font-sans text-[12.5px] font-semibold transition-colors sm:min-h-9",
              @liked? && "text-accent-red",
              !@liked? && "text-ink-500 hover:text-ink-800"
            ]}
          >
            <.icon name={if @liked?, do: "hero-heart-solid", else: "hero-heart"} class="size-4" />
            {like_label(@liked?, @like_count)}
          </button>
        </div>

        <%!-- Sending the receipt: through the app, where it lands next to the
             payment control, or through WhatsApp, where people already are.
             Both only for whoever is in the class, the same criterion as the
             Pix key.
        --%>
        <div
          :if={@enrolled? && !Workshop.free?(@workshop)}
          class="mt-5 border-t border-ink-200 pt-4"
        >
          <.receipt_box
            receipt={@my_receipt}
            upload={@uploads.receipt}
            whatsapp_link={Workshop.receipt_link(@workshop)}
          />
        </div>

        <%!-- The face of whoever teaches: it introduces the teacher and leads to
             their profile, which is where the name circulates.
        --%>
        <div class="mt-5 border-t border-ink-200 pt-4">
          <p class="m-0 mb-2 font-sans text-[10.5px] font-semibold uppercase tracking-[1.4px] text-ink-500">
            Quem dá a aula
          </p>
          <%!-- A teacher without an account comes in as a name only: waiting for the
               account to exist before announcing the class would hold up the real
               world for the database. No account means no profile, so no link.
          --%>
          <.link
            :for={teacher <- Enum.filter(@teachers, & &1.username)}
            navigate={~p"/users/#{teacher.username}"}
            class="flex items-center gap-2.5 py-1 no-underline"
          >
            <.user_avatar user={teacher} size={:md} />
            <span class="min-w-0">
              <span class="block truncate font-serif text-[13.5px] font-bold text-ink-900">
                {teacher.name || teacher.username}
              </span>
              <span class="block truncate font-sans text-[11.5px] text-ink-500">
                @{teacher.username}
              </span>
            </span>
          </.link>

          <div
            :for={teacher <- Enum.reject(@teachers, & &1.username)}
            class="flex items-center gap-2.5 py-1"
          >
            <.user_avatar user={teacher} size={:md} />
            <span class="block truncate font-serif text-[13.5px] font-bold text-ink-900">
              {teacher.name}
            </span>
          </div>
        </div>
      </aside>

      <div class="lg:order-1">
        <%!-- `whitespace-pre-line` wraps only the text: on the container it would turn
             the newlines of the template itself into blank lines on the page. --%>
        <.editable
          field={:description}
          label="descrição"
          type={:long_text}
          layout={:block}
          editing={@editing_field}
          can_edit={@organizer?}
          value={InlineEditParams.form_value(@workshop, :description)}
          error={@edit_error}
        >
          <p class="m-0 max-w-[62ch] whitespace-pre-line text-[15px] leading-relaxed text-ink-800">
            {@workshop.description}
          </p>
        </.editable>

        <%!-- Storefront: whoever has not entered sees the shape of what is inside,
             never the content. Hiding it would say "there is nothing here"; showing
             it would give away what is paid for. Blurred with the count underneath
             says the only thing that matters from outside: there are people in here.
        --%>
        <.locked_preview
          :if={@storefront?}
          enrolled_count={@enrolled_count}
          comment_count={length(@comments)}
        />

        <%!-- Steps taught in the class: the missing link between the workshop and the
             collection. A click opens the step sheet, with the learn gesture,
             without leaving this page.
        --%>
        <section
          :if={!@storefront? && (@steps != [] || @organizer?)}
          class="mt-8 border-t border-ink-200 pt-6"
        >
          <.section_heading>Passos desta aula</.section_heading>

          <p :if={@steps == []} class="m-0 mb-2 font-sans text-[13px] text-ink-500">
            Nenhum passo marcado ainda. Vincule o que foi dado para quem esteve na aula
            achar depois.
          </p>

          <div class="flex flex-wrap gap-2">
            <%!-- Um traço só diz o que a pessoa já aprendeu: o visto. Antes eram duas
                 famílias de cor inteiras, verde e âmbar, para dizer a mesma coisa. --%>
            <%!-- 36px de altura: a pílula fica densa o bastante para caber cinco
                 passos na tela e alta o bastante para o dedo acertar uma só. --%>
            <span
              :for={step <- @steps}
              class={[
                "inline-flex min-h-9 items-center rounded-full border text-[12px]",
                MapSet.member?(@learned_codes, step.code) && "border-ink-400 text-ink-900",
                !MapSet.member?(@learned_codes, step.code) && "border-ink-300 text-ink-700"
              ]}
            >
              <button
                type="button"
                phx-click="open_step_sheet"
                phx-value-code={step.code}
                class="inline-flex min-h-9 cursor-pointer items-center gap-1.5 rounded-l-full pl-3 pr-2 transition-colors hover:bg-ink-200/60"
              >
                <.icon
                  :if={MapSet.member?(@learned_codes, step.code)}
                  name="hero-check-circle-solid"
                  class="size-3.5 text-accent-green"
                />
                <code class="font-sans text-[11.5px] font-bold">{step.code}</code>
                <span class="font-serif text-ink-600">{step.name}</span>
              </button>
              <button
                :if={@organizer?}
                type="button"
                phx-click="remove_workshop_step"
                phx-value-id={step.step_id}
                aria-label={"Tirar #{step.code} da lista"}
                class="group inline-flex min-h-9 min-w-8 cursor-pointer items-center justify-center rounded-r-full pl-1 pr-2.5"
              >
                <.icon name="hero-x-mark" class="size-3.5 opacity-50 group-hover:opacity-100" />
              </button>
              <span :if={!@organizer?} class="rounded-r-full pr-2"></span>
            </span>
          </div>

          <%!-- Only an admin builds the list: it is what the class offered, and
               whoever taught it knows what they offered.
          --%>
          <div :if={@organizer?} class="mt-3 max-w-[22rem]">
            <.step_search
              id="workshop-step-search"
              suggestions={@step_search}
              placeholder="+ Vincular passo dado nesta aula"
              search_event="search_workshop_step"
              add_event="add_workshop_step"
            />
          </div>
        </section>

        <%!-- The step list is not a sequence: a class teaches one or two names and
             the combination is a separate thing. Whoever teaches cites the refined
             one here; whoever attends takes it home by favoriting.
        --%>
        <section
          :if={!@storefront? && (@workshop_sequences != [] || @organizer?)}
          class="mt-8 border-t border-ink-200 pt-6"
        >
          <.section_heading>Sequências desta aula</.section_heading>

          <p :if={@workshop_sequences == []} class="m-0 mb-2 font-sans text-[13px] text-ink-500">
            Nenhuma sequência ainda. Monte a combinação que você deu para quem esteve
            aqui levar pra casa.
          </p>

          <div>
            <div
              :for={cited <- @workshop_sequences}
              class="border-t border-ink-200 first:border-t-0"
            >
              <div class="flex items-center gap-1">
                <button
                  type="button"
                  phx-click="toggle_sequence_steps"
                  phx-value-id={cited.sequence_id}
                  aria-expanded={
                    to_string(@open_sequence && @open_sequence.id == cited.sequence_id)
                  }
                  class="flex min-h-11 flex-1 cursor-pointer items-center gap-2 rounded-lg px-1 text-left font-serif text-[13.5px] font-semibold text-ink-800 hover:text-gold-600"
                >
                  <span class="font-sans text-[12px] font-bold text-gold-600">→</span>
                  {cited.name}
                  <span class="font-sans text-[11px] font-medium text-ink-500">
                    {cited.step_count} {if cited.step_count == 1, do: "passo", else: "passos"}
                  </span>
                </button>

                <button
                  :if={@current_user}
                  type="button"
                  phx-click="toggle_sequence_favorite"
                  phx-value-id={cited.sequence_id}
                  aria-label={"Favoritar #{cited.name}"}
                  class="grid size-11 cursor-pointer place-items-center rounded-lg text-ink-400 hover:text-gold-600"
                >
                  <.icon
                    name={
                      if MapSet.member?(@sequence_favorites, cited.sequence_id),
                        do: "hero-heart-solid",
                        else: "hero-heart"
                    }
                    class={[
                      "size-4",
                      MapSet.member?(@sequence_favorites, cited.sequence_id) && "text-gold-600"
                    ]}
                  />
                </button>

                <button
                  :if={@organizer?}
                  type="button"
                  phx-click="uncite_sequence"
                  phx-value-id={cited.sequence_id}
                  aria-label={"Tirar #{cited.name} desta aula"}
                  class="grid size-11 cursor-pointer place-items-center rounded-lg text-ink-400 hover:text-ink-700"
                >
                  <.icon name="hero-x-mark" class="size-3.5" />
                </button>
              </div>

              <div
                :if={@open_sequence && @open_sequence.id == cited.sequence_id}
                class="flex flex-wrap items-center gap-1.5 pb-3 pl-4"
              >
                <span
                  :for={{sequence_step, index} <- Enum.with_index(@open_sequence.sequence_steps)}
                  data-sequence-step={sequence_step.step.code}
                  class="inline-flex items-center gap-1.5 text-[12px]"
                >
                  <span :if={index > 0} class="font-sans text-[11px] font-bold text-gold-600">
                    →
                  </span>
                  <code class="font-sans text-[11px] font-bold text-ink-900">
                    {sequence_step.step.code}
                  </code>
                  <span class="text-ink-600">{sequence_step.step.name}</span>
                </span>
              </div>
            </div>
          </div>

          <div :if={@organizer?} class="mt-3 flex flex-wrap gap-2">
            <button
              type="button"
              phx-click="open_sequence_sheet"
              phx-value-tab="new"
              class="inline-flex min-h-9 cursor-pointer items-center gap-1.5 rounded-full border border-ink-300 px-3.5 font-sans text-[12px] font-semibold text-ink-600 transition hover:border-gold-500 hover:text-gold-600"
            >
              <span aria-hidden="true">→</span> montar sequência
            </button>
            <button
              type="button"
              phx-click="open_sequence_sheet"
              phx-value-tab="mine"
              class="inline-flex min-h-9 cursor-pointer items-center rounded-full border border-ink-300 px-3.5 font-sans text-[12px] font-semibold text-ink-600 transition hover:border-gold-500 hover:text-gold-600"
            >
              citar uma minha
            </button>
          </div>
        </section>

        <section
          :if={!@storefront? && @current_user && @participants != []}
          class="mt-8 border-t border-ink-200 pt-6"
        >
          <.section_heading>Quem vai</.section_heading>
          <%!-- Rostos de verdade em vez de inicial dentro de pílula: numa turma de
               dança a pessoa reconhece a cara antes de ler o nome. --%>
          <div class="flex flex-wrap gap-x-5 gap-y-2.5">
            <span :for={p <- @participants} class="inline-flex items-center gap-2">
              <.user_avatar user={p} size={:xs} />
              <span class="font-sans text-[12.5px] text-ink-700">{p.name || p.username}</span>
            </span>
          </div>
        </section>

        <p
          :if={is_nil(@current_user) && @enrolled_count > 0}
          class="mt-6 font-sans text-[13px] text-ink-500"
        >
          {people_label(@enrolled_count)} até agora.
          <a
            href={~p"/login?#{[return_to: ~p"/workshops/#{@workshop.slug}"]}"}
            class="font-semibold text-accent-orange"
          >
            Entre
          </a>
          para ver quem vai.
        </p>

        <%!-- Gallery: only for whoever is in the workshop. --%>
        <section
          :if={!@storefront? && @can_see_media?}
          class="mt-8 border-t border-ink-200 pt-6"
        >
          <.section_heading>Fotos e vídeos</.section_heading>
          <p class="m-0 mb-3 font-sans text-[12.5px] text-ink-500">
            Só quem está no workshop vê e manda. O que vem de quem dá a aula aparece primeiro.
          </p>

          <.media_gallery
            :if={@media != []}
            media={@media}
            current_user={@current_user}
            can_delete_any={@organizer? || false}
          />

          <p :if={@media == []} class="m-0 mb-3 font-sans text-[13px] text-ink-500">
            Nada aqui ainda. Mande a primeira foto ou o primeiro vídeo do workshop.
          </p>

          <form id="media-form" phx-submit="upload_media" phx-change="validate_media" class="mt-3">
            <%!-- The native input stays hidden (sr-only, not display:none, which
                 would take it out of the keyboard path) and the label becomes the
                 button: the text of the native control belongs to the browser, and
                 comes out in English.
            --%>
            <label
              for={@uploads.media.ref}
              class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-ink-300 px-4 font-serif text-[12.5px] font-semibold text-ink-700 transition-colors hover:border-ink-400 sm:min-h-9"
            >
              <.icon name="hero-arrow-up-tray" class="size-4" /> Escolher foto ou vídeo
            </label>
            <.live_file_input upload={@uploads.media} class="sr-only" />

            <div :for={entry <- @uploads.media.entries} class="mt-2 flex items-center gap-3">
              <span class="font-sans text-[12px] text-ink-500">{entry.client_name}</span>
              <span class="font-sans text-[12px] font-bold text-ink-700">{entry.progress}%</span>
            </div>

            <div :for={entry <- @uploads.media.entries}>
              <p
                :for={error <- upload_errors(@uploads.media, entry)}
                class="m-0 mt-1 font-sans text-[12px] font-semibold text-accent-red"
              >
                {media_upload_error(error)}
              </p>
            </div>

            <button
              :if={@uploads.media.entries != []}
              type="submit"
              phx-disable-with="Enviando..."
              class="mt-2 cursor-pointer rounded-full border-0 bg-ink-900 px-4 py-2 font-serif text-[13px] font-semibold text-ink-50"
            >
              Enviar para a galeria
            </button>
          </form>
        </section>

        <%!-- Conversa: aberta a leitura, escrita exige conta --%>
        <section :if={!@storefront?} class="mt-8 border-t border-ink-200 pt-6">
          <.section_heading>Conversa</.section_heading>

          <p :if={@comments == []} class="m-0 mb-3 font-sans text-[13px] text-ink-500">
            Ninguém comentou ainda. Dúvida sobre horário, nível ou o que levar? Pergunte aqui.
          </p>

          <.comment_thread
            comments={@comments}
            current_user={@current_user}
            likes_map={@comment_likes}
            comment_type="workshop_comment"
            parent_id={@workshop.id}
            replying_to={@replying_to}
            replies_map={@replies_map}
            can_moderate={@can_moderate?}
            badges={@comment_badges}
            show_form={@can_comment?}
          >
            <:form_placeholder>
              <p :if={@workshop.status == :draft} class="m-0 font-sans text-[13px] text-ink-500">
                A conversa abre quando você publicar o workshop.
              </p>
              <p :if={@workshop.status != :draft} class="m-0 font-sans text-[13px] text-ink-500">
                <.link
                  navigate={~p"/login?#{[return_to: ~p"/workshops/#{@workshop.slug}"]}"}
                  class="font-semibold text-accent-orange"
                >
                  Entre para comentar
                </.link>
                e falar com quem vai.
              </p>
            </:form_placeholder>
          </.comment_thread>
        </section>
      </div>
    </div>
    <.last_updated :if={@organizer?} at={@workshop.updated_at} />
  </main>

  <.social_bubble
    :if={@current_user}
    current_user={@current_user}
    suggested_users={@suggested_users}
    following_user_ids={@following_user_ids}
    bubble_open={@bubble_open}
    bubble_tab={@bubble_tab}
    bubble_following_list={@bubble_following_list}
    bubble_followers_list={@bubble_followers_list}
    bubble_search={@bubble_search}
    bubble_search_results={@bubble_search_results}
    following_count={@following_count}
    followers_count={@followers_count}
  />

  <.bottom_nav
    :if={@current_user}
    current_user={@current_user}
    current_path={~p"/study"}
    notification_count={assigns[:notification_count] || 0}
    pending_study_count={assigns[:pending_study_count] || 0}
  />
</div>

<.step_sheet step={@step_sheet} learned={@step_sheet_learned} />
<.sequence_sheet
  tab={@sequence_sheet}
  draft_steps={@sequence_draft_steps}
  draft_name={@sequence_draft_name}
  search_term={@sequence_search_term}
  step_matches={@sequence_step_matches}
  mine={@sequence_mine}
  cited_ids={MapSet.new(@workshop_sequences, & &1.sequence_id)}
/>
