<div id="program-shell" class="min-h-screen bg-ink-100 font-serif flex flex-col">
  <.flash kind={:info} id="lv-flash-info" flash={@flash} />
  <.flash kind={:error} id="lv-flash-error" flash={@flash} />

  <.top_nav
    :if={@current_user}
    current_user={@current_user}
    is_admin={@is_admin || false}
    nav_mode={:detail}
    title="Programação"
  />

  <%!-- Sem conta o link tem que abrir mesmo assim: ele circula no WhatsApp --%>
  <header :if={is_nil(@current_user)} class="bg-ink-900 px-4 py-3 text-center">
    <.link
      navigate={~p"/"}
      class="brand-display text-[13px] tracking-[2.4px] text-ink-50 no-underline"
    >
      O GRUPO DE ESTUDOS
    </.link>
  </header>

  <main class="mx-auto w-full max-w-[860px] flex-1 px-4 py-6 sm:px-6">
    <div :if={@program.status == :draft} class="mb-4 rounded-xl bg-gold-500/15 px-4 py-3">
      <p class="m-0 text-[13px] font-bold text-ink-700">
        Ainda é rascunho: só você enxerga. Publique para o link funcionar para os outros.
      </p>
    </div>

    <div :if={@program.status == :cancelled} class="mb-4 rounded-xl bg-accent-red/10 px-4 py-3">
      <p class="m-0 text-[13px] font-bold text-accent-red">
        Esta programação foi cancelada.
      </p>
    </div>

    <%!-- O cartaz acompanha o titulo em vez de tomar a tela: quem abre o link
    quer saber o que tem e quando, e o flyer reforca sem atrapalhar. --%>
    <div class="flex flex-wrap items-start gap-5">
      <img
        :if={@program.flyer_path}
        src={@program.flyer_path}
        alt={"Flyer de #{@program.title}"}
        class="w-[130px] shrink-0 rounded-xl border border-ink-200 object-cover shadow-sm sm:w-[170px]"
      />

      <div class="min-w-0 flex-1">
        <p class="m-0 mb-1 text-[11px] font-bold uppercase tracking-[2px] text-accent-purple">
          Programação
        </p>
        <h1 class="m-0 font-serif text-[26px] font-bold leading-tight tracking-tight text-ink-900 sm:text-[30px]">
          {@program.title}
        </h1>

        <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] text-ink-500">
          <span class="font-bold text-ink-900">{program_span(@days, @workshop_count)}</span>
          <span :if={@program.location}>{@program.location}</span>
          <span>por <b class="text-ink-900">{@program.owner.name}</b></span>
        </div>
      </div>
    </div>

    <div :if={@owner?} class="mt-4 flex flex-wrap gap-2">
      <.link
        navigate={~p"/study/programacoes/#{@program.slug}/editar"}
        class="rounded-full border border-ink-300 bg-ink-50 px-4 py-2 font-serif text-[13px] font-semibold text-ink-700 no-underline"
      >
        Editar programação
      </.link>
      <button
        :if={@program.status == :draft}
        type="button"
        phx-click="publish"
        phx-disable-with="Publicando..."
        class="cursor-pointer rounded-full border-0 bg-accent-orange px-4 py-2 font-serif text-[13px] font-semibold text-white"
      >
        Publicar
      </button>
    </div>

    <p
      :if={@program.description}
      class="mt-5 whitespace-pre-line text-[14.5px] leading-relaxed text-ink-800"
    >
      {@program.description}
    </p>

    <%!-- As duas formas de participar: pacote fechado ou dia a dia --%>
    <div :if={@tem_pacote?} class="mt-6 grid gap-4 sm:grid-cols-[1fr_1fr]">
      <.package_box
        program={@program}
        avulso_total={@avulso_total}
        ja_comprou={not is_nil(@matricula_pacote)}
        indisponivel={@pacote_indisponivel}
      />

      <div class="rounded-2xl border border-dashed border-ink-300 p-4">
        <p class="m-0 font-serif text-[15px] font-bold text-ink-900">Ou escolha os dias</p>
        <p class="m-0 mt-1 text-[12.5px] leading-snug text-ink-500">
          Dá para pegar só os workshops que te interessam, cada um pelo preço dele.
          Some {money_label(@avulso_total)} se você levar todos.
        </p>
        <p class="m-0 mt-2 text-[12.5px] text-ink-500">
          Marque na lista abaixo e confirme no fim.
        </p>
      </div>
    </div>

    <%!-- Os workshops, dia a dia --%>
    <section class="mt-7">
      <div :for={{date, workshops} <- @days} class="mb-6 last:mb-0">
        <h2 class="m-0 mb-2.5 text-[11px] font-bold uppercase tracking-[2px] text-ink-500">
          {day_heading(date)}
        </h2>

        <div class="flex flex-col gap-2.5">
          <.workshop_card
            :for={w <- workshops}
            id_prefix="programacao"
            workshop={w}
            enrolled_count={Map.get(@enrollment_counts, w.id, 0)}
            enrolled?={MapSet.member?(@enrolled_ids, w.id)}
            organizer?={false}
          >
            <:select>
              <input
                :if={MapSet.member?(@selecionaveis, w.id)}
                type="checkbox"
                id={"escolher-#{w.id}"}
                checked={MapSet.member?(@selecionados, w.id)}
                phx-click="toggle_selection"
                phx-value-id={w.id}
                aria-label={"Marcar #{w.title}"}
                class="size-5 cursor-pointer accent-accent-orange"
              />
              <.icon
                :if={MapSet.member?(@enrolled_ids, w.id)}
                name="hero-check-circle-solid"
                class="size-5 text-accent-green"
              />
            </:select>
          </.workshop_card>
        </div>
      </div>

      <%!-- Pacote: quem comprou e quem pagou. So quem criou ve. --%>
      <section
        :if={@owner? && @tem_pacote?}
        class="mt-8 rounded-2xl border border-ink-200 bg-ink-50 p-4 sm:p-5"
      >
        <h2 class="m-0 text-[12.5px] font-bold text-ink-700">Quem levou a programação toda</h2>
        <p class="m-0 mt-1 mb-3 text-[12px] leading-snug text-ink-500">
          Só você vê isto. Quem escolheu dias avulsos aparece no painel de cada workshop.
        </p>

        <div class="mb-3 grid grid-cols-3 gap-2.5">
          <div class="rounded-xl border border-ink-200 bg-ink-100/40 p-3 text-center">
            <p class="m-0 font-serif text-[19px] font-bold leading-none text-ink-900">
              {@resumo_pacote.packages}
            </p>
            <p class="m-0 mt-1 text-[10px] font-bold uppercase tracking-[1.2px] text-ink-500">
              pacotes
            </p>
          </div>
          <div class="rounded-xl border border-ink-200 bg-ink-100/40 p-3 text-center">
            <p class="m-0 font-serif text-[19px] font-bold leading-none text-accent-green">
              {@resumo_pacote.paid}
            </p>
            <p class="m-0 mt-1 text-[10px] font-bold uppercase tracking-[1.2px] text-ink-500">
              pagaram
            </p>
          </div>
          <div class="rounded-xl border border-ink-200 bg-ink-100/40 p-3 text-center">
            <p class="m-0 font-serif text-[19px] font-bold leading-none text-ink-900">
              {money_label(@resumo_pacote.revenue_cents)}
            </p>
            <p class="m-0 mt-1 text-[10px] font-bold uppercase tracking-[1.2px] text-ink-500">
              recebido
            </p>
          </div>
        </div>

        <div :if={@pacotes != []} class="flex flex-col gap-1.5">
          <div
            :for={linha <- @pacotes}
            id={"pacote-#{linha.id}"}
            class="flex flex-wrap items-center gap-2 rounded-xl border border-ink-200 bg-ink-100/40 px-3 py-2"
          >
            <span class="min-w-0 flex-1">
              <span class="block truncate text-[13px] font-bold text-ink-900">{linha.name}</span>
              <span class="block truncate text-[11.5px] text-ink-500">@{linha.username}</span>
            </span>
            <.workshop_tag tone={tom_do_pagamento(linha.payment_status)}>
              {payment_status_label(linha.payment_status)}
            </.workshop_tag>
            <button
              :if={linha.payment_status != :paid}
              type="button"
              phx-click="set_package_payment"
              phx-value-id={linha.id}
              phx-value-status="paid"
              class="shrink-0 cursor-pointer rounded-full border-0 bg-ink-900 px-3 py-1.5 font-serif text-[12px] font-semibold text-ink-50"
            >
              Marcar pago
            </button>
            <button
              :if={linha.payment_status == :paid}
              type="button"
              phx-click="set_package_payment"
              phx-value-id={linha.id}
              phx-value-status="pending"
              class="shrink-0 cursor-pointer rounded-full border border-ink-300 bg-ink-50 px-3 py-1.5 font-serif text-[12px] font-semibold text-ink-600"
            >
              Desfazer
            </button>
          </div>
        </div>

        <p :if={@pacotes == []} class="m-0 text-[13px] text-ink-500">
          Ninguém levou o pacote fechado ainda.
        </p>
      </section>

      <%!-- Montagem: quem organiza mexe sem sair da pagina --%>
      <section :if={@owner?} class="mt-8 rounded-2xl border border-ink-200 bg-ink-50 p-4 sm:p-5">
        <h2 class="m-0 text-[12.5px] font-bold text-ink-700">Montar a programação</h2>
        <p class="m-0 mt-1 mb-3 text-[12px] leading-snug text-ink-500">
          Só você vê isto. Dá para tirar e pôr workshop a qualquer momento, inclusive
          depois de publicar.
        </p>

        <div :if={@dentro != []} class="flex flex-col gap-1.5">
          <div
            :for={w <- @dentro}
            id={"dentro-#{w.id}"}
            class="flex flex-wrap items-center gap-2 rounded-xl border border-ink-200 bg-ink-100/40 px-3 py-2"
          >
            <span class="min-w-0 flex-1">
              <span class="block truncate text-[13px] font-bold text-ink-900">{w.title}</span>
              <span class="block truncate text-[11.5px] text-ink-500">{schedule_label(w)}</span>
            </span>
            <.workshop_tag :if={w.status == :draft} tone={:neutral}>Rascunho</.workshop_tag>
            <button
              type="button"
              phx-click="detach_workshop"
              phx-value-id={w.id}
              class="shrink-0 cursor-pointer rounded-full border border-ink-300 bg-ink-50 px-3 py-1.5 font-serif text-[12px] font-semibold text-ink-600"
            >
              Tirar
            </button>
          </div>
        </div>

        <div :if={@disponiveis != []} class="mt-4">
          <p class="m-0 mb-1.5 text-[11px] font-bold uppercase tracking-[1.4px] text-ink-500">
            Seus workshops fora desta programação
          </p>
          <div class="flex flex-col gap-1.5">
            <div
              :for={w <- @disponiveis}
              id={"fora-#{w.id}"}
              class="flex flex-wrap items-center gap-2 rounded-xl border border-dashed border-ink-300 px-3 py-2"
            >
              <span class="min-w-0 flex-1">
                <span class="block truncate text-[13px] font-bold text-ink-800">{w.title}</span>
                <span class="block truncate text-[11.5px] text-ink-500">{schedule_label(w)}</span>
              </span>
              <button
                type="button"
                phx-click="attach_workshop"
                phx-value-id={w.id}
                class="shrink-0 cursor-pointer rounded-full border-0 bg-ink-900 px-3 py-1.5 font-serif text-[12px] font-semibold text-ink-50"
              >
                Adicionar
              </button>
            </div>
          </div>
        </div>

        <.link
          navigate={~p"/study/workshops/novo?#{[programa: @program.slug]}"}
          class="mt-4 inline-flex items-center gap-1.5 rounded-full border-0 bg-accent-orange px-4 py-2 font-serif text-[13px] font-semibold text-white no-underline"
        >
          <.icon name="hero-plus" class="size-4" /> Criar workshop já nesta programação
        </.link>
      </section>

      <%!-- Confirma tudo de uma vez: marcar nao inscreve, para um toque errado
      no celular nao tirar ninguem de um workshop pago. --%>
      <div
        :if={MapSet.size(@selecionaveis) > 0}
        class="mt-5 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-ink-200 bg-ink-50 px-4 py-3"
      >
        <p class="m-0 text-[13px] text-ink-600">
          {selecao_label(MapSet.size(@selecionados))}
        </p>
        <button
          type="button"
          phx-click="confirm_enrollment"
          phx-disable-with="Inscrevendo..."
          disabled={MapSet.size(@selecionados) == 0}
          class={[
            "cursor-pointer rounded-full border-0 px-5 py-2.5 font-serif text-[14px] font-semibold transition-colors",
            MapSet.size(@selecionados) > 0 &&
              "bg-accent-orange text-white hover:bg-accent-orange/90",
            MapSet.size(@selecionados) == 0 && "cursor-not-allowed bg-ink-200 text-ink-400"
          ]}
        >
          Confirmar inscrição
        </button>
      </div>

      <.workshop_empty
        :if={@days == []}
        title="Nenhum workshop nesta programação ainda"
        description={
          if @owner?,
            do: "Adicione os seus workshops na tela de edição.",
            else: "Volte em breve: quem organiza ainda está montando."
        }
      />
    </section>
  </main>
</div>
