<div id="program-shell" class="min-h-screen bg-ink-100 font-serif flex flex-col">
  <.flash kind={:info} id="lv-flash-info" flash={@flash} />
  <.flash kind={:error} id="lv-flash-error" flash={@flash} />

  <.top_nav
    :if={@current_user}
    current_user={@current_user}
    is_admin={@is_admin || false}
    nav_mode={:detail}
    title="Programação"
  />

  <%!-- Sem conta o link tem que abrir mesmo assim: ele circula no WhatsApp --%>
  <header :if={is_nil(@current_user)} class="bg-ink-900 px-4 py-3 text-center">
    <.link
      navigate={~p"/"}
      class="brand-display text-[13px] tracking-[2.4px] text-ink-50 no-underline"
    >
      O GRUPO DE ESTUDOS
    </.link>
  </header>

  <main class="mx-auto w-full max-w-[860px] flex-1 px-4 py-6 sm:px-6">
    <div :if={@program.status == :draft} class="mb-4 rounded-xl bg-gold-500/15 px-4 py-3">
      <p class="m-0 text-[13px] font-bold text-ink-700">
        Ainda é rascunho: só você enxerga. Publique para o link funcionar para os outros.
      </p>
    </div>

    <div :if={@program.status == :cancelled} class="mb-4 rounded-xl bg-accent-red/10 px-4 py-3">
      <p class="m-0 text-[13px] font-bold text-accent-red">
        Esta programação foi cancelada.
      </p>
    </div>

    <p class="m-0 mb-1 text-[11px] font-bold uppercase tracking-[2px] text-accent-purple">
      Programação
    </p>
    <h1 class="m-0 font-serif text-[26px] font-bold leading-tight tracking-tight text-ink-900 sm:text-[30px]">
      {@program.title}
    </h1>

    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] text-ink-500">
      <span class="font-bold text-ink-900">{program_span(@days, @workshop_count)}</span>
      <span :if={@program.location}>{@program.location}</span>
      <span>por <b class="text-ink-900">{@program.owner.name}</b></span>
    </div>

    <div :if={@owner?} class="mt-4 flex flex-wrap gap-2">
      <.link
        navigate={~p"/study/programacoes/#{@program.slug}/editar"}
        class="rounded-full border border-ink-300 bg-ink-50 px-4 py-2 font-serif text-[13px] font-semibold text-ink-700 no-underline"
      >
        Editar programação
      </.link>
      <button
        :if={@program.status == :draft}
        type="button"
        phx-click="publish"
        phx-disable-with="Publicando..."
        class="cursor-pointer rounded-full border-0 bg-accent-orange px-4 py-2 font-serif text-[13px] font-semibold text-white"
      >
        Publicar
      </button>
    </div>

    <p
      :if={@program.description}
      class="mt-5 whitespace-pre-line text-[14.5px] leading-relaxed text-ink-800"
    >
      {@program.description}
    </p>

    <%!-- Os workshops, dia a dia --%>
    <section class="mt-7">
      <div :for={{date, workshops} <- @days} class="mb-6 last:mb-0">
        <h2 class="m-0 mb-2.5 text-[11px] font-bold uppercase tracking-[2px] text-ink-500">
          {day_heading(date)}
        </h2>

        <div class="flex flex-col gap-2.5">
          <.workshop_card
            :for={w <- workshops}
            id_prefix="programacao"
            workshop={w}
            enrolled_count={Map.get(@enrollment_counts, w.id, 0)}
            enrolled?={MapSet.member?(@enrolled_ids, w.id)}
            organizer?={false}
          />
        </div>
      </div>

      <%!-- Montagem: quem organiza mexe sem sair da pagina --%>
      <section :if={@owner?} class="mt-8 rounded-2xl border border-ink-200 bg-ink-50 p-4 sm:p-5">
        <h2 class="m-0 text-[12.5px] font-bold text-ink-700">Montar a programação</h2>
        <p class="m-0 mt-1 mb-3 text-[12px] leading-snug text-ink-500">
          Só você vê isto. Dá para tirar e pôr workshop a qualquer momento, inclusive
          depois de publicar.
        </p>

        <div :if={@dentro != []} class="flex flex-col gap-1.5">
          <div
            :for={w <- @dentro}
            id={"dentro-#{w.id}"}
            class="flex flex-wrap items-center gap-2 rounded-xl border border-ink-200 bg-ink-100/40 px-3 py-2"
          >
            <span class="min-w-0 flex-1">
              <span class="block truncate text-[13px] font-bold text-ink-900">{w.title}</span>
              <span class="block truncate text-[11.5px] text-ink-500">{schedule_label(w)}</span>
            </span>
            <.workshop_tag :if={w.status == :draft} tone={:neutral}>Rascunho</.workshop_tag>
            <button
              type="button"
              phx-click="detach_workshop"
              phx-value-id={w.id}
              class="shrink-0 cursor-pointer rounded-full border border-ink-300 bg-ink-50 px-3 py-1.5 font-serif text-[12px] font-semibold text-ink-600"
            >
              Tirar
            </button>
          </div>
        </div>

        <div :if={@disponiveis != []} class="mt-4">
          <p class="m-0 mb-1.5 text-[11px] font-bold uppercase tracking-[1.4px] text-ink-500">
            Seus workshops fora desta programação
          </p>
          <div class="flex flex-col gap-1.5">
            <div
              :for={w <- @disponiveis}
              id={"fora-#{w.id}"}
              class="flex flex-wrap items-center gap-2 rounded-xl border border-dashed border-ink-300 px-3 py-2"
            >
              <span class="min-w-0 flex-1">
                <span class="block truncate text-[13px] font-bold text-ink-800">{w.title}</span>
                <span class="block truncate text-[11.5px] text-ink-500">{schedule_label(w)}</span>
              </span>
              <button
                type="button"
                phx-click="attach_workshop"
                phx-value-id={w.id}
                class="shrink-0 cursor-pointer rounded-full border-0 bg-ink-900 px-3 py-1.5 font-serif text-[12px] font-semibold text-ink-50"
              >
                Adicionar
              </button>
            </div>
          </div>
        </div>

        <.link
          navigate={~p"/study/workshops/novo?#{[programa: @program.slug]}"}
          class="mt-4 inline-flex items-center gap-1.5 rounded-full border-0 bg-accent-orange px-4 py-2 font-serif text-[13px] font-semibold text-white no-underline"
        >
          <.icon name="hero-plus" class="size-4" /> Criar workshop já nesta programação
        </.link>
      </section>

      <.workshop_empty
        :if={@days == []}
        title="Nenhum workshop nesta programação ainda"
        description={
          if @owner?,
            do: "Adicione os seus workshops na tela de edição.",
            else: "Volte em breve: quem organiza ainda está montando."
        }
      />
    </section>
  </main>
</div>
