<div id="program-shell" class="min-h-screen bg-ink-100 font-serif flex flex-col">
  <.flash kind={:info} id="lv-flash-info" flash={@flash} />
  <.flash kind={:error} id="lv-flash-error" flash={@flash} />

  <.top_nav
    :if={@current_user}
    current_user={@current_user}
    is_admin={@is_admin || false}
    nav_mode={@nav_mode}
    notification_count={assigns[:notification_count] || 0}
    pending_suggestions_count={assigns[:pending_suggestions_count] || 0}
  />

  <%!-- Without an account the link still has to open: it circulates on WhatsApp. --%>
  <header :if={is_nil(@current_user)} class="bg-ink-900 px-4 py-3 text-center">
    <.link
      navigate={~p"/"}
      class="brand-display text-[13px] tracking-[2.4px] text-ink-50 no-underline"
    >
      O GRUPO DE ESTUDOS
    </.link>
  </header>

  <%!-- A state of the whole page is a band across it, not a card floating above
       the content: it is the paper that changed, not one more item on it. --%>
  <p
    :if={@program.status == :draft}
    class="m-0 border-b border-gold-500/30 bg-gold-500/10 px-4 py-2.5 text-center font-sans text-[12.5px] text-ink-700"
  >
    Ainda é rascunho: só você enxerga. Publique para o link funcionar para os outros.
  </p>

  <p
    :if={@program.status == :cancelled}
    class="m-0 border-b border-accent-red/25 bg-accent-red/[0.07] px-4 py-2.5 text-center font-sans text-[12.5px] font-semibold text-accent-red"
  >
    Esta programação foi cancelada.
  </p>

  <main class="mx-auto w-full max-w-[820px] flex-1 px-4 py-7 pb-24 sm:px-6 sm:py-9 md:pb-9">
    <%!-- A volta que a página nunca teve: sem ela, quem chegava pela agenda só
         saía pelo gesto do sistema. --%>
    <.link
      :if={@current_user}
      navigate={~p"/study/workshops"}
      class="mb-4 inline-flex min-h-11 items-center gap-1.5 font-sans text-[12.5px] font-semibold text-ink-500 no-underline hover:text-ink-800 sm:min-h-0"
    >
      <.icon name="hero-arrow-left" class="size-4" /> Workshops
    </.link>

    <%!-- The flyer is the thing that actually circulated on WhatsApp, so it opens
         the page at the size of a poster and the title reads beside it. --%>
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-7">
      <img
        :if={@program.flyer_path}
        src={@program.flyer_path}
        alt={"Flyer de #{@program.title}"}
        class="w-[52%] max-w-[240px] shrink-0 self-start rounded-lg border border-ink-200 object-cover shadow-sm sm:w-[230px] sm:max-w-none"
      />

      <div class="min-w-0 flex-1">
        <.editable
          field={:title}
          label="nome da programação"
          editing={@editing_field}
          can_edit={@owner?}
          value={InlineEditParams.form_value(@program, :title)}
          error={@edit_error}
        >
          <h1 class="brand-display is-title m-0 text-[28px] font-semibold leading-[1.12] tracking-tight text-ink-900 sm:text-[34px]">
            {@program.title}
          </h1>
        </.editable>

        <%!-- Quando, onde e de quem: uma coisa por linha. Numa linha só, com
             pontos entre elas, o olho lê um endereço de arquivo. --%>
        <div class="mt-3 font-sans text-[13px] leading-relaxed text-ink-500">
          <p class="m-0 font-semibold text-ink-900">{program_span(@days, @workshop_count)}</p>

          <.editable
            :if={@program.location || @owner?}
            field={:location}
            label="onde"
            editing={@editing_field}
            can_edit={@owner?}
            value={InlineEditParams.form_value(@program, :location)}
            hint="Uma linha de chamada. O endereço de verdade fica em cada workshop."
            error={@edit_error}
          >
            <span>{@program.location || "sem lugar definido"}</span>
          </.editable>

          <p class="m-0">por <b class="font-semibold text-ink-700">{@program.owner.name}</b></p>
        </div>

        <div :if={@owner?} class="mt-4 flex flex-wrap gap-2">
          <.link
            navigate={~p"/study/programs/#{@program.slug}/edit"}
            class="rounded-full border border-ink-300 px-4 py-2 font-serif text-[13px] font-semibold text-ink-700 no-underline transition-colors hover:border-ink-400"
          >
            Editar programação
          </.link>
          <button
            :if={@program.status == :draft}
            type="button"
            phx-click="publish"
            phx-disable-with="Publicando..."
            class="cursor-pointer rounded-full border-0 bg-accent-orange px-4 py-2 font-serif text-[13px] font-semibold text-on-accent"
          >
            Publicar
          </button>
        </div>
      </div>
    </div>

    <div :if={@program.description || @owner?} class="mt-6 max-w-[62ch]">
      <.editable
        field={:description}
        label="descrição"
        type={:long_text}
        layout={:block}
        editing={@editing_field}
        can_edit={@owner?}
        value={InlineEditParams.form_value(@program, :description)}
        error={@edit_error}
      >
        <p class="m-0 whitespace-pre-line text-[15px] leading-relaxed text-ink-800">
          {@program.description || "sem descrição"}
        </p>
      </.editable>
    </div>

    <.package_offer
      :if={@tem_pacote?}
      program={@program}
      avulso_total={@avulso_total}
      ja_comprou={not is_nil(@matricula_pacote)}
      indisponivel={@pacote_indisponivel}
      selecionaveis={MapSet.size(@selecionaveis) > 0}
    />

    <%!-- The package has no WhatsApp of its own: the program carries no phone,
         so here the app is the whole path. --%>
    <div :if={@tem_pacote? && @matricula_pacote} class="mt-5 max-w-[26rem]">
      <.receipt_box receipt={@my_package_receipt} upload={@uploads.receipt} />
    </div>

    <%!-- Os workshops, dia a dia --%>
    <section class="mt-9">
      <p
        :if={!@tem_pacote? && MapSet.size(@selecionaveis) > 0}
        class="m-0 mb-5 font-sans text-[12.5px] text-ink-500"
      >
        Marque os dias que te interessam e confirme no fim da lista.
      </p>

      <div :for={{date, workshops} <- @days} class="mb-7 last:mb-0">
        <%!-- A regra que fecha o título do dia é a borda de cima da primeira linha:
             uma linha só, no lugar de duas coladas. --%>
        <h2 class="brand-display is-title m-0 mb-2 text-[17px] font-semibold tracking-tight text-ink-800 first-letter:uppercase">
          {day_heading(date)}
        </h2>

        <.agenda_row
          :for={w <- workshops}
          workshop={w}
          enrolled_count={Map.get(@enrollment_counts, w.id, 0)}
          enrolled?={MapSet.member?(@enrolled_ids, w.id)}
          selectable?={MapSet.member?(@selecionaveis, w.id)}
          selected?={MapSet.member?(@selecionados, w.id)}
        />
      </div>

      <%!-- Confirms everything at once: checking does not enroll, so a wrong tap on a
           phone does not pull anyone out of a paid workshop.
      --%>
      <div
        :if={MapSet.size(@selecionaveis) > 0}
        class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-ink-200 pt-5"
      >
        <p class="m-0 font-sans text-[13px] text-ink-600">
          {selecao_label(MapSet.size(@selecionados))}
        </p>
        <button
          type="button"
          phx-click="confirm_enrollment"
          phx-disable-with="Inscrevendo..."
          disabled={MapSet.size(@selecionados) == 0}
          class={[
            "cursor-pointer rounded-full border-0 px-5 py-2.5 font-serif text-[14px] font-semibold transition-colors",
            MapSet.size(@selecionados) > 0 &&
              "bg-accent-orange text-on-accent hover:bg-accent-orange/90",
            MapSet.size(@selecionados) == 0 && "cursor-not-allowed bg-ink-200 text-ink-400"
          ]}
        >
          Confirmar inscrição
        </button>
      </div>

      <.workshop_empty
        :if={@days == []}
        title="Nenhum workshop nesta programação ainda"
        description={
          if @owner?,
            do: "Adicione os seus workshops na tela de edição.",
            else: "Volte em breve: quem organiza ainda está montando."
        }
      />
    </section>

    <%!-- Bastidores: tudo o que só quem organiza vê fica atrás de uma linha só,
         em vez de virar mais duas caixas competindo com a programação. --%>
    <section :if={@owner?} class="mt-12 border-t-2 border-ink-300 pt-6">
      <p class="m-0 font-sans text-[10.5px] font-semibold uppercase tracking-[1.6px] text-ink-500">
        Bastidores
      </p>
      <p class="m-0 mt-1 font-sans text-[12.5px] text-ink-500">
        Só você vê daqui para baixo.
      </p>

      <%!-- Package: who bought and who paid. --%>
      <div :if={@tem_pacote?} class="mt-7">
        <.section_heading>Quem levou a programação toda</.section_heading>

        <p class="m-0 mb-4 font-sans text-[13px] text-ink-600">
          <b class="font-semibold text-ink-900">{@package_summary.packages}</b>
          {if @package_summary.packages == 1, do: "pacote", else: "pacotes"},
          <b class="font-semibold text-ink-900">{@package_summary.paid}</b>
          {if @package_summary.paid == 1, do: "pagou", else: "pagaram"},
          <b class="font-semibold text-ink-900">{money_label(@package_summary.revenue_cents)}</b>
          recebido. Quem escolheu dias avulsos aparece no painel de cada workshop.
        </p>

        <%!-- Onde o dinheiro do pacote cai. Sem isto, o painel de cada workshop
             mostra um valor que não bate com o preço dele e parece erro. --%>
        <div :if={@package_shares != []} class="mb-5 rounded-xl bg-ink-100 px-4 py-3">
          <p class="m-0 font-sans text-[11px] font-semibold uppercase tracking-[1.4px] text-ink-500">
            Como cada pacote se divide
          </p>
          <p
            :for={share <- @package_shares}
            class="m-0 mt-1.5 flex items-baseline justify-between gap-3 font-sans text-[12.5px] text-ink-600"
          >
            <span class="min-w-0 truncate">{share.title}</span>
            <b class="shrink-0 font-semibold text-ink-900">{money_label(share.share_cents)}</b>
          </p>
          <p class="m-0 mt-2 font-sans text-[11.5px] leading-snug text-ink-500">
            É esse valor que entra no "recebido" de cada workshop, não o preço avulso dele.
          </p>
        </div>

        <div :if={@pacotes != []}>
          <div
            :for={linha <- @pacotes}
            id={"pacote-#{linha.id}"}
            class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-ink-200 py-2.5 first:border-t-0"
          >
            <span class="min-w-0 flex-1">
              <span class="block truncate font-serif text-[13.5px] font-bold text-ink-900">
                {linha.name}
              </span>
              <span class="block truncate font-sans text-[11.5px] text-ink-500">
                @{linha.username}
              </span>
            </span>

            <a
              :if={linha.receipt_sent_at}
              href={~p"/program-receipts/#{linha.id}"}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 shrink-0 items-center gap-1 font-sans text-[12px] font-semibold text-ink-600 no-underline hover:text-ink-900 sm:min-h-0"
            >
              <.icon name="hero-paper-clip" class="size-3.5" /> Comprovante
            </a>

            <span class={[
              "shrink-0 font-sans text-[12px] font-semibold",
              linha.payment_status == :paid && "text-accent-green",
              linha.payment_status != :paid && "text-ink-500"
            ]}>
              {payment_status_label(linha.payment_status)}
            </span>

            <button
              :if={linha.payment_status != :paid}
              type="button"
              phx-click="set_package_payment"
              phx-value-id={linha.id}
              phx-value-status="paid"
              class="shrink-0 cursor-pointer rounded-full border-0 bg-ink-900 px-3 py-1.5 font-serif text-[12px] font-semibold text-ink-50"
            >
              Marcar pago
            </button>
            <button
              :if={linha.payment_status == :paid}
              type="button"
              phx-click="set_package_payment"
              phx-value-id={linha.id}
              phx-value-status="pending"
              class="shrink-0 cursor-pointer rounded-full border border-ink-300 px-3 py-1.5 font-serif text-[12px] font-semibold text-ink-600"
            >
              Desfazer
            </button>
          </div>
        </div>

        <p :if={@pacotes == []} class="m-0 font-sans text-[13px] text-ink-500">
          Ninguém levou o pacote fechado ainda.
        </p>
      </div>

      <%!-- Assembly: the organizer changes it without leaving the page. --%>
      <div class="mt-8">
        <.section_heading>Montar a programação</.section_heading>

        <p class="m-0 mb-4 font-sans text-[12.5px] leading-snug text-ink-500">
          Dá para tirar e pôr workshop a qualquer momento, inclusive depois de publicar.
        </p>

        <div :if={@dentro != []}>
          <div
            :for={w <- @dentro}
            id={"dentro-#{w.id}"}
            class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-ink-200 py-2.5 first:border-t-0"
          >
            <span class="min-w-0 flex-1">
              <span class="block truncate font-serif text-[13.5px] font-bold text-ink-900">
                {w.title}
              </span>
              <span class="block truncate font-sans text-[11.5px] text-ink-500">
                {schedule_label(w)}<span :if={w.status == :draft}> · rascunho</span>
              </span>
            </span>
            <button
              type="button"
              phx-click="detach_workshop"
              phx-value-id={w.id}
              class="shrink-0 cursor-pointer rounded-full border border-ink-300 px-3 py-1.5 font-serif text-[12px] font-semibold text-ink-600"
            >
              Tirar
            </button>
          </div>
        </div>

        <div :if={@disponiveis != []} class="mt-5">
          <p class="m-0 mb-1 font-sans text-[12.5px] font-semibold text-ink-600">
            Seus workshops fora desta programação
          </p>
          <div
            :for={w <- @disponiveis}
            id={"fora-#{w.id}"}
            class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-ink-200 py-2.5"
          >
            <span class="min-w-0 flex-1">
              <span class="block truncate font-serif text-[13.5px] font-bold text-ink-800">
                {w.title}
              </span>
              <span class="block truncate font-sans text-[11.5px] text-ink-500">
                {schedule_label(w)}
              </span>
            </span>
            <button
              type="button"
              phx-click="attach_workshop"
              phx-value-id={w.id}
              class="shrink-0 cursor-pointer rounded-full border-0 bg-ink-900 px-3 py-1.5 font-serif text-[12px] font-semibold text-ink-50"
            >
              Adicionar
            </button>
          </div>
        </div>

        <.link
          navigate={~p"/study/workshops/new?#{[program: @program.slug]}"}
          class="mt-5 inline-flex items-center gap-1.5 rounded-full border border-ink-300 px-4 py-2 font-serif text-[13px] font-semibold text-ink-700 no-underline transition-colors hover:border-ink-400"
        >
          <.icon name="hero-plus" class="size-4" /> Criar workshop já nesta programação
        </.link>
      </div>

      <.last_updated at={@program.updated_at} />
    </section>
  </main>

  <.bottom_nav
    :if={@current_user}
    current_user={@current_user}
    current_path={~p"/study"}
    notification_count={assigns[:notification_count] || 0}
    pending_study_count={assigns[:pending_study_count] || 0}
  />
</div>
