<.flash kind={:info} id="lv-flash-info" flash={@flash} />
<.flash kind={:error} id="lv-flash-error" flash={@flash} />
<% i_am_teacher = @current_user.id == @link.teacher_id %>
<div class="min-h-screen bg-ink-100 font-serif flex flex-col">
  <.top_nav
    current_user={@current_user}
    is_admin={@is_admin}
    pending_suggestions_count={assigns[:pending_suggestions_count] || 0}
    nav_mode={@nav_mode}
    title="Diário compartilhado"
    notification_count={assigns[:notification_count] || 0}
    notification_dropdown_enabled={true}
    notification_dropdown_open={assigns[:notification_dropdown_open] || false}
    notification_preview_groups={assigns[:notification_preview_groups] || []}
    notification_targets={@notification_targets}
    pending_study_count={assigns[:pending_study_count] || 0}
    online_users={assigns[:online_users] || []}
    online_count={assigns[:online_count] || 0}
  />

  <main class="mx-auto flex w-full max-w-[1200px] flex-1 flex-col gap-4 px-4 py-5 pb-24 md:pb-10 sm:px-6 lg:px-8">
    <.link
      navigate={~p"/study"}
      class="inline-flex min-h-11 w-fit items-center gap-1.5 font-sans text-[12.5px] font-semibold text-ink-500 no-underline transition-colors hover:text-ink-800 sm:min-h-0"
    >
      <.icon name="hero-arrow-left" class="size-3.5" />
      {if i_am_teacher, do: "Meus alunos", else: "Meus professores"}
    </.link>

    <%!-- De quem é o diário: o nome inteiro e a relação em palavra. A etiqueta em
         caixa alta ao lado do nome dizia o que a página inteira já diz, e no
         celular era ela que espremia o nome. --%>
    <header class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-ink-200 pb-5">
      <.link
        navigate={~p"/users/#{@counterpart.username}"}
        class="flex min-w-0 flex-1 items-center gap-3 no-underline"
      >
        <.user_avatar user={@counterpart} size={:lg} />
        <div class="min-w-0">
          <h1 class="brand-display is-title m-0 text-[22px] font-semibold leading-tight tracking-tight text-ink-900">
            {@counterpart.name}
          </h1>
          <p class="m-0 mt-0.5 font-sans text-[12px] text-ink-500">
            @{@counterpart.username} · {if i_am_teacher, do: "seu aluno", else: "seu professor"}
          </p>
        </div>
      </.link>
      <p
        :if={!@link.active}
        class="m-0 shrink-0 font-sans text-[12px] font-semibold text-ink-500"
      >
        Vínculo encerrado
      </p>
    </header>

    <p
      :if={!@link.active}
      class="m-0 font-sans text-[12.5px] leading-relaxed text-ink-500"
    >
      O histórico continua visível, mas a nota está somente leitura.
    </p>

    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div class="flex min-w-0 flex-col gap-4">
        <.diary_card
          learned_codes={@learned_codes}
          id="shared-diary"
          title="Nota de hoje"
          description="Vocês dois escrevem aqui: o que estudaram, o que funcionou e o que vale revisar."
          placeholder="Escrevam juntos o que rolou na aula de hoje..."
          rows={6}
          form_as={:shared_note}
          content={@today_note_content}
          related_steps={@shared_related_steps}
          suggestions={@shared_step_suggestions}
          disabled={!@link.active}
          save_event="save_shared_note"
          search_event="search_shared_step"
          add_event="add_shared_step"
          remove_event="remove_shared_step"
        >
          <:meta>
            <span class="inline-flex items-center gap-1 text-[11px] text-ink-400">
              <.icon
                :if={@link.active && is_nil(@note_saved_at)}
                name="hero-check"
                class="size-3 text-accent-green"
              />
              <span :if={@note_saved_at && @link.active} class="font-semibold text-accent-green">
                <.icon name="hero-check-circle" class="size-3.5 -mt-0.5" />
                Salvo às {Calendar.strftime(@note_saved_at, "%H:%M")}
              </span>
              <span :if={is_nil(@note_saved_at) || !@link.active}>
                {if @link.active, do: "Salvando automaticamente", else: "Somente leitura"}
              </span>
            </span>
          </:meta>
        </.diary_card>

        <section
          :if={@lessons != []}
          id="teacher-lessons"
          class="border-t border-ink-200 pt-5"
        >
          <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <h3 class="brand-display is-title m-0 text-[16px] font-semibold tracking-tight text-ink-800">
              Lições do professor
            </h3>
            <span class="font-sans text-[11.5px] text-ink-500">
              {length(@lessons)} {if length(@lessons) == 1, do: "lição", else: "lições"}
            </span>
          </div>

          <div>
            <article
              :for={lesson <- @lessons}
              id={"lesson-#{lesson.id}"}
              class="border-t border-ink-200 py-3.5 first:border-t-0 first:pt-0"
            >
              <div class="mb-1 flex flex-wrap items-center gap-2">
                <span class="text-[13px] font-bold text-ink-900">{lesson.title}</span>
                <span
                  :if={!i_am_teacher and MapSet.member?(@new_lesson_ids, lesson.id)}
                  class="font-sans text-[11px] font-bold text-accent-red"
                >
                  Nova
                </span>
                <span class="ml-auto font-sans text-[11px] text-ink-500">
                  {OGrupoDeEstudos.Brazil.format_date(lesson.inserted_at)}
                </span>
              </div>

              <p class={[
                "m-0 whitespace-pre-line font-serif text-[13px] leading-relaxed text-ink-700",
                !MapSet.member?(@expanded_lesson_ids, lesson.id) && "line-clamp-3"
              ]}>
                {lesson.content}
              </p>

              <div :if={lesson.steps != []} class="mt-2 flex flex-wrap gap-1">
                <.step_pill
                  :for={step <- lesson.steps}
                  step={step}
                  learned={MapSet.member?(@learned_codes, step.code)}
                />
              </div>

              <div class="mt-1.5 flex items-center gap-2">
                <button
                  :if={lesson_long?(lesson.content)}
                  type="button"
                  phx-click="toggle_lesson_expansion"
                  phx-value-id={lesson.id}
                  class="inline-flex min-h-11 cursor-pointer items-center border-0 bg-transparent p-0 font-sans text-[11.5px] font-semibold text-ink-600 underline sm:min-h-0"
                >
                  {if MapSet.member?(@expanded_lesson_ids, lesson.id),
                    do: "ver menos",
                    else: "ver mais"}
                </button>
                <span :if={i_am_teacher} class="ml-auto font-sans text-[11px] text-ink-500">
                  {if lesson.read_at, do: "Lida pelo aluno", else: "Ainda não lida"}
                </span>
              </div>
            </article>
          </div>
        </section>

        <.note_history
          learned_codes={@learned_codes}
          notes={@history}
          count_label={
            "#{length(@history)} #{if length(@history) == 1, do: "aula", else: "aulas"}"
          }
          expanded_ids={@expanded_note_ids}
          editing_note_id={@editing_history_note_id}
          suggestions={@history_step_suggestions}
          editable={@link.active}
        >
          <:empty>
            <.empty_state
              title="O diário de vocês começa aqui"
              description="As notas compartilhadas aparecem aqui conforme vocês forem registrando o estudo."
            />
          </:empty>
        </.note_history>
      </div>

      <%!-- Sidebar --%>
      <aside class="flex min-w-0 flex-col gap-4">
        <.sidebar_card>
          <div class="mb-3 flex items-center gap-3">
            <.link navigate={~p"/users/#{@counterpart.username}"} class="no-underline">
              <.user_avatar user={@counterpart} size={:md} />
            </.link>
            <div class="min-w-0">
              <p class="m-0 truncate font-serif text-sm font-bold text-ink-900">
                {@counterpart.name}
              </p>
              <p class="m-0 text-[11px] text-ink-500">@{@counterpart.username}</p>
            </div>
          </div>

          <.stat_line stats={[
            {length(@history), if(length(@history) == 1, do: "aula", else: "aulas")},
            {length(@shared_step_ranking),
             if(length(@shared_step_ranking) == 1, do: "passo", else: "passos")}
          ]} />

          <div :if={i_am_teacher} class="mt-3 border-t border-ink-200 pt-3">
            <form phx-change="save_teacher_note" phx-debounce="1000">
              <input type="hidden" name="link-id" value={@link.id} />
              <label class="mb-1 flex items-center gap-1 font-sans text-[11.5px] font-semibold text-ink-600">
                <.icon name="hero-lock-closed" class="size-3" /> Anotação privada
              </label>
              <textarea
                name="note"
                rows="2"
                placeholder="Observações sobre este aluno..."
                class="w-full resize-y rounded-lg border border-ink-200 bg-ink-100/40 px-2.5 py-1.5 font-serif text-xs text-ink-700 outline-none transition-colors focus:border-ink-400"
              >{@link.teacher_note}</textarea>
              <p class="m-0 mt-0.5 text-[10px] text-ink-400">Só você vê esta anotação.</p>
            </form>
          </div>
        </.sidebar_card>

        <.sidebar_card title="Metas de estudo">
          <.goals_board goals={@shared_goals} goal_input={@goal_input} />
        </.sidebar_card>

        <.sidebar_card :if={@shared_step_ranking != []} title="Passos mais estudados">
          <.step_ranking ranking={@shared_step_ranking} total_notes={length(@history)} />
        </.sidebar_card>
      </aside>
    </div>
  </main>

  <.social_bubble
    current_user={@current_user}
    suggested_users={@suggested_users}
    following_user_ids={@following_user_ids}
    bubble_open={@bubble_open}
    bubble_tab={@bubble_tab}
    bubble_following_list={@bubble_following_list}
    bubble_followers_list={@bubble_followers_list}
    bubble_search={@bubble_search}
    bubble_search_results={@bubble_search_results}
    following_count={@following_count}
    followers_count={@followers_count}
  />

  <.bottom_nav
    current_user={@current_user}
    current_path={~p"/study"}
    notification_count={assigns[:notification_count] || 0}
    pending_study_count={assigns[:pending_study_count] || 0}
  />
</div>

<%!-- Step sheet: it opens on top, so whoever was reading the note does not lose their
     place.
--%>
<.step_sheet step={@step_sheet} learned={@step_sheet_learned} />
